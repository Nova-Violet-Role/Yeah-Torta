// THE DESIGN FINALE — the Tortä 4-TAB SLINT HOME (OMEGA Stage-D · D3, charter step 8:
// "① HOME (dnsmasq×rethink hybrid) · ② Tortä ENGINE · ③ DNS · ④ QUERY — the full UI-substrate
// Genesis wave; the last Garmatin surface → a Rust original").
//
// ONE root Window (`TortaShell`) = the app Home the host constructs:
//   · the TOP STRIP — the ||| door (fires `open-advanced()` → the host swaps to the D2
//     AdvancedBurger, the step-7 navigation surface) + the identity + the live engine dot.
//   · the CONTENT REGION — the four tabs as visibility-switched overlays (the D2 alias law: an
//     embedded pane whose state the root forwards as `<=>` aliases cannot live inside an `if`;
//     overlays keep the aliases + pane state stable across navigation). HOME / ENGINE / DNS scroll
//     (the G5 no-clip law); QUERY hosts its own virtualized ListView, so it mounts bare.
//   · the 4-TAB BAR — HOME · ENGINE · DNS · QUERY; the active tab wears the bone strike + THE EYE
//     underline (the Monokuma judge language as the app-shell chrome, the B4-G9 direction D2 set).
//
// THE TABS:
//   ① HOME   — home_tab.slint  (the dnsmasq×rethink hybrid: crown + master switch + the resolver
//              ledger counters + the pillar health chips)
//   ② ENGINE — engine_tab.slint (the Beast porthole: gear crown, RTT witnesses, tin basins, valves)
//   ③ DNS    — dnscrypt_section.slint (THE SAME K5 typed surface the ||| burger embeds — one pane
//              component, one typed authority, two mounts; the root forwards the IDENTICAL alias
//              set the burger forwards, so ONE host feed drives either mount)
//   ④ QUERY  — query_tab.slint (the unified per-pillar query-log feed)
//
// This replaces the `TortaRoot` proof-of-substrate stub — the Design Finale IS the substrate now.
// The 12 pillar Windows stay host-routed via the ||| burger's private tabs (the D2 contract).

import { ScrollView, LineEdit } from "std-widgets.slint";
import { Monokuma } from "monokuma_palette.slint";
// #33 THE THEME-TOKEN SPINE — the in-shell ||| ADVANCED overlay chrome binds `ThemeBook.burger`
// (the Demon-Slayer duality: ◆ PILLARS = Hashira heroes, ⚙ GENERAL = Akuma Upper Moons).
import { ThemeBook, MotifWash, CharcoalLump } from "theme_tokens.slint";
import { HomeTab } from "home_tab.slint";
import { EngineTab } from "engine_tab.slint";
import { QueryTab, QueryRow } from "query_tab.slint";
import { DnscryptSection, Candle, PickerRow } from "dnscrypt_section.slint";
import { GeneralSection } from "general_section.slint";
import { PillarTabRow, PillarTab, RailEntry, DescentWash } from "advanced_burger.slint";
// 2-FEED-MaskSolver: the MaskSolver pillar dashboard mounts IN-SHELL as a ||| overlay section (the
// per-pillar DASHBOARD chip route). The pane is fed field-for-field by the host from the live
// MaskSolver Object; MaskRow/MaskTransportRow are the typed feed-row structs the aliases carry.
import { MaskSolverPane, MaskRow, MaskTransportRow } from "masksolver.slint";
import { MaskSolverSettingsPane } from "masksolver_settings.slint";
// 2-FEED-Rotation (SETTINGS): the Rotation pillar SETTINGS mounts IN-SHELL as a ||| overlay section (the
// "rotation-settings" section, reached via ||| → PILLARS → ROTATION settings chip). RotationSettingsPane
// inherits Rectangle so it embeds on the single android surface (the MaskSolver/Warden/Centauri precedent).
import { RotationSettingsPane } from "rotation_settings.slint";
// 2-FEED-Beast (SETTINGS): the Beast pillar SETTINGS (THE FLOW-ENGINE TUNE — YeAH brain × CAKE queue ×
// preset table) mounts IN-SHELL as a ||| overlay section (the "beast-settings" section, reached via ||| →
// PILLARS → BEAST settings chip). BeastSettingsPane inherits Rectangle so it embeds on the single android
// surface (the MaskSolver/Rotation/Warden/Centauri precedent).
import { BeastSettingsPane } from "beast_settings.slint";
// 2-FEED-Inu (SETTINGS): the Wire Cake Inu pillar SETTINGS (the ADB/Shizuku elevation surface — pair · protect
// · keep) mounts IN-SHELL as a ||| overlay section (the "inu-settings" section, reached via ||| → PILLARS →
// WIRE CAKE INU settings chip). InuSettingsPane inherits Rectangle so it embeds on the single android surface
// (the Beast/MaskSolver/Rotation/Warden/Centauri precedent). PowerToggleRow is the typed per-power feed-row.
import { InuSettingsPane, PowerToggleRow } from "inu_settings.slint";
// #15 UNDERGROUND H — the pillar's OWN space (the standing directive: OUT of the ENGINE tab):
// the licence-court dashboard + the tunable-law settings mount in-shell as the
// "underground-dash" / "underground-settings" advanced sections.
import { UndergroundDashboardPane, UgHostRow } from "underground_dashboard.slint";
import { UndergroundSettingsPane } from "underground_settings.slint";
// 2-FEED-Centauri: the Centauri pillar dashboard mounts IN-SHELL as a ||| overlay section (the
// "centauri-dash" section, reached via the per-pillar DASHBOARD chip — the SAME embed pattern as
// MaskSolver). The pane is fed field-for-field by the host from the live Centauri Object; ServeRow
// is the typed recent-serve feed-row the aliases carry.
import { CentauriPane, ServeRow } from "centauri.slint";
// 2-FEED-Centauri (SETTINGS): the Centauri pillar SETTINGS mounts IN-SHELL as a ||| overlay section (the
// "centauri-settings" section, reached via the per-pillar SETTINGS chip — the SAME embed pattern as the
// dashboards). Unlike the dashboards (read-only witnesses), this pane WRITES the live armed engine: the
// user's edits surface as typed callbacks the host wires to the armed Object setters (set_cache_mode /
// warm_up), the flat resolver cloak fn, and the durable seed-policy pref (the CROWN's control plane).
// CdnHostRow is the typed cloak-host feed-row the host fills from `centauri_cdn_hosts()`.
import { CentauriSettingsPane, CdnHostRow } from "centauri_settings.slint";
// 2-FEED-Beast: the Beast pillar dashboard mounts IN-SHELL as a ||| overlay section (the "beast-dash"
// section, reached via the per-pillar DASHBOARD chip — the SAME embed pattern as MaskSolver/Centauri).
// BeastPane is fed field-for-field by the host from the live Beast Object; BeastTickRow is the typed
// query-beast.log recent-tick feed-row the aliases carry.
import { BeastPane, BeastTickRow } from "beast.slint";
// ★ #49 · the NETSTACK FORWARDER dashboard pane (the per-flow docket surface). Imported DIRECTLY —
// a Rectangle-rooted pane must enter the compile graph here, not through the root re-export (the
// measured slint rule main.slint documents on BeastPane).
import { ForwarderPane, FwdFlowRow } from "forwarder_dashboard.slint";
// 2-FEED-Rotation: the Rotation pillar dashboard mounts IN-SHELL as a ||| overlay section (the
// "rotation-dash" section, reached via the per-pillar DASHBOARD chip — the SAME embed pattern as
// MaskSolver/Centauri/Beast). RotationPane is fed field-for-field by the host from the live
// `MaskSolver::rotation_snapshot()` Record; RotationFamilyRow (the wheel ring) / RotationHintRow (the
// warm-RTT leaderboard) / RotationLogRow (the query-rotation.log feed) are the typed feed-row structs
// the aliases carry.
import { RotationPane, RotationFamilyRow, RotationHintRow, RotationLogRow } from "rotation.slint";
// 4-FIX round 3 · 2-FEED-Warden: the Warden pillar dashboard mounts IN-SHELL as a ||| overlay section (the
// "warden-dash" section, reached via the per-pillar DASHBOARD chip — the SAME embed pattern as the four
// pillars above; closes the "WARDEN dashboard silent no-op" witness finding). WardenPane is fed
// field-for-field by the host from the live `WardenObject::snapshot()`; AppRow is the per-app matrix row.
import { WardenPane, AppRow, FlowRow, ToggleRow, InspectorAppRow, InspectorDestRow } from "warden.slint";
// 2-FEED-Warden (SETTINGS): the Warden pillar |||  settings pane mounts IN-SHELL as the "warden-settings"
// overlay section (reached via the per-pillar SETTINGS chip — the SAME embed pattern as CentauriSettings).
// Unlike the read-only dashboard, this pane WRITES the live armed engine (the canonical WardenDatapathGate the
// datapath consults): the user's edits surface as typed `warden-*` callbacks the host wires to the Object
// setters. UniversalToggle / RuleEntry / AppToggleRow are the typed feed-row structs the
// `ws-*` aliases carry (distinct from warden.slint's read-only AppRow — these are editable).
import { WardenSettingsPane, UniversalToggle, RuleEntry, AppToggleRow } from "warden_settings.slint";

// #60B-2 CARBON SETTINGS: the 13th pillar's ||| settings pane mounts IN-SHELL as the
// "carbon-settings" section (Install Extension lane + capabilities law + 60G role skeleton).
import { CarbonSettingsPane } from "carbon_settings.slint";
// 4-FIX round 3 · 2-FEED-Inu: the Wire Cake Inu pillar dashboard mounts IN-SHELL as a ||| overlay section
// (the "inu-dash" section — closes the "INU dashboard silent no-op" witness finding). InuPane is fed
// field-for-field by the host from the live `InuStore` snapshot; PowerRow (the protected-power tiles) /
// InuLogRow (the query-inu.log feed) are the typed feed-row structs the aliases carry.
import { InuPane, PowerRow, InuLogRow } from "inu.slint";

// (BUGS2 #64) The bottom-bar `TabSlot` component is RETIRED with the 4-tab bar itself — every
// route (HOME / ENGINE ROOM / DNSCRYPT tab / QUERY) now lives in the ||| burger rail, the ONE
// navigation authority. The `active-tab` router + all four content mounts remain unchanged.

export component TortaShell inherits Window {
    // ===== #33 THEME-TOKEN SPINE — full-surface drench (z-first child; glass panels above). =====
    MotifWash { theme: ThemeBook.home; width: 100%; height: 100%; }

    // ===== #36 "MUGENJŌ" — the HOME ambient (the Infinity Castle reference): shoji-paper
    //       lattice walls sliding past each other (the castle rearranges itself), the lantern
    //       procession breathing warm light toward one cold-lit doorway, Nakime's biwa note
    //       rippling the room every ninth second, and ember bokeh drifting the void.
    //       Pure animation-tick; zero timers; under the glass. =====
    mugenjo := Rectangle {
        width: 100%; height: 100%;
        clip: true;
        background: transparent;
        property <float> tk: animation-tick() / 1ms;

        // THE SLIDING SHOJI — two lattice bands gliding at different speeds (never in lockstep);
        // the cell pattern repeats each 56px, so the drift wrap is invisible — an endless wall.
        for band in [{ top: 0.055, sp: 26000.0, al: 0.10 }, { top: 0.585, sp: 34000.0, al: 0.07 }]: Rectangle {
            x: 0; y: parent.height * band.top;
            width: 100%; height: 118px;
            clip: true;
            opacity: band.al;
            Rectangle {
                x: -56px * Math.mod(mugenjo.tk / band.sp, 1.0);
                y: 0;
                width: parent.width + 112px;
                height: 100%;
                background: #4a2318;            // the dark red-brown wood frame
                for c in 12 : Rectangle {       // warm paper cells; the gaps read as mullions
                    x: 4px + c * 56px;
                    y: 4px;
                    width: 48px; height: parent.height - 8px;
                    border-radius: 2px;
                    background: @linear-gradient(180deg, #e0b184 0%, #c4916a 100%);
                    Rectangle { x: 0; y: parent.height * 0.31; width: 100%; height: 5px; background: #4a2318; }
                    Rectangle { x: 0; y: parent.height * 0.64; width: 100%; height: 5px; background: #4a2318; }
                }
            }
        }

        // THE LANTERN PROCESSION — two rows converging on the doorway (perspective scale);
        // every paper body breathes on its own phase, nothing pulses together.
        for l in [
            { cx: 0.05, cy: 0.53, s: 1.00, ph: 0.00 },
            { cx: 0.19, cy: 0.565, s: 0.74, ph: 0.31 },
            { cx: 0.30, cy: 0.585, s: 0.55, ph: 0.62 },
            { cx: 0.85, cy: 0.53, s: 1.00, ph: 0.17 },
            { cx: 0.73, cy: 0.565, s: 0.74, ph: 0.48 },
            { cx: 0.63, cy: 0.585, s: 0.55, ph: 0.79 },
        ]: Rectangle {
            x: parent.width * l.cx; y: parent.height * l.cy;
            width: 60px * l.s; height: 74px * l.s;
            background: transparent;
            Rectangle {                         // the warm halo — the breath
                x: parent.width / 2 - self.width / 2;
                y: parent.height * 0.34 - self.height / 2;
                width: 84px * l.s; height: 84px * l.s;
                border-radius: self.width / 2;
                background: @radial-gradient(circle, #f0a848.with-alpha(0.20) 0%, transparent 70%);
                opacity: 0.55 + 0.35 * sin(360deg * Math.mod(mugenjo.tk / 3400.0 + l.ph, 1.0));
            }
            Rectangle {                         // top cap
                x: parent.width * 0.30; y: 0;
                width: parent.width * 0.40; height: 6px * l.s;
                border-radius: 2px; background: #241410;
            }
            Rectangle {                         // the paper body
                x: parent.width * 0.14; y: 5px * l.s;
                width: parent.width * 0.72; height: parent.height * 0.62;
                border-radius: 4px;
                background: @linear-gradient(180deg, #ffd98a 0%, #f0a848 62%, #c47830 100%);
                opacity: 0.80 + 0.20 * sin(360deg * Math.mod(mugenjo.tk / 3400.0 + l.ph, 1.0));
                Rectangle { x: parent.width * 0.47; y: 0; width: 2px; height: 100%; background: #8a4a20.with-alpha(0.45); }
            }
            Rectangle {                         // bottom cap + the stand stem
                x: parent.width * 0.26; y: parent.height * 0.66;
                width: parent.width * 0.48; height: 5px * l.s;
                border-radius: 2px; background: #241410;
            }
            Rectangle {
                x: parent.width / 2 - 1px; y: parent.height * 0.70;
                width: 2px; height: parent.height * 0.30;
                background: #241410;
            }
        }

        // THE COLD DOORWAY — the one teal light in the warm dark; someone is waiting
        doorway := Rectangle {
            x: parent.width / 2 - 37px; y: parent.height * 0.495;
            width: 74px; height: 112px;
            border-width: 3px; border-color: #3a1c12;
            background: @linear-gradient(180deg, #5a9aaa 0%, #2a4a5a 100%);
            opacity: 0.11 + 0.04 * sin(360deg * Math.mod(mugenjo.tk / 7700.0, 1.0));
            Rectangle { x: parent.width / 3 - 1px; y: 0; width: 2px; height: 100%; background: #10202a; }
            Rectangle { x: parent.width * 2 / 3 - 1px; y: 0; width: 2px; height: 100%; background: #10202a; }
            Rectangle { x: 0; y: parent.height / 3 - 1px; width: 100%; height: 2px; background: #10202a; }
            Rectangle { x: 0; y: parent.height * 2 / 3 - 1px; width: 100%; height: 2px; background: #10202a; }
            Rectangle {                         // the silhouette
                x: parent.width / 2 - 9px; y: parent.height * 0.36;
                width: 18px; height: parent.height * 0.60;
                border-radius: 9px;
                background: #10202a;
            }
        }

        // NAKIME'S NOTE — one biwa pluck every 9.4s; the ring ripples out and the castle holds
        Rectangle {
            property <float> p: Math.mod(mugenjo.tk / 9400.0, 1.0);
            property <float> g: Math.min(self.p, 0.22) / 0.22;
            x: parent.width * 0.16 - self.width / 2;
            y: parent.height * 0.12 - self.height / 2;
            width: 8px + 112px * self.g; height: self.width;
            border-radius: self.width / 2;
            background: transparent;
            border-width: 1.5px;
            border-color: #f0a848.with-alpha(self.p < 0.22 ? 0.45 * (1 - self.g) : 0.0);
        }

        // THE EMBER BOKEH — five soft orbs rising the void, each on its own clock
        for e in 5 : Rectangle {
            property <float> p: Math.mod(mugenjo.tk / (11000.0 + e * 2300.0), 1.0);
            x: parent.width * Math.mod(0.12 + e * 0.19 + 0.05 * sin(360deg * self.p), 1.0);
            y: parent.height * (0.92 - 0.80 * self.p);
            width: 10px + e * 2px; height: self.width;
            border-radius: self.width / 2;
            background: @radial-gradient(circle, #f0a848.with-alpha(0.30) 0%, transparent 70%);
            opacity: 0.5 * Math.sin(180deg * self.p);
        }

        // THE ABYSS WINDOWS — the castle seen from above (the darker refs): fourteen far-off
        // rooms scattered in the void, each candle on its own clock; one in four burns pale.
        for w in 14 : Rectangle {
            x: parent.width * Math.mod(0.04 + w * 0.171, 1.0);
            y: parent.height * (0.02 + Math.mod(w * 0.093, 0.42));
            width: 4px + Math.mod(w, 3) * 2px;
            height: 6px + Math.mod(w, 3) * 2px;
            border-radius: 1px;
            background: Math.mod(w, 4) == 0 ? #e8e0c8 : #f0a848;
            opacity: 0.06 + 0.10 * Math.abs(sin(360deg * Math.mod(mugenjo.tk / (4100.0 + w * 700.0), 1.0)));
        }

        // THE CRIMSON EDGES — the red verticals framing the tilt (ref #15), breathing slow
        Rectangle {
            x: 0; y: 0; width: 26px; height: 100%;
            background: @linear-gradient(90deg, #8b1a2a.with-alpha(0.18) 0%, transparent 100%);
            opacity: 0.55 + 0.30 * sin(360deg * Math.mod(mugenjo.tk / 8300.0, 1.0));
        }
        Rectangle {
            x: parent.width - 26px; y: 0; width: 26px; height: 100%;
            background: @linear-gradient(270deg, #8b1a2a.with-alpha(0.18) 0%, transparent 100%);
            opacity: 0.55 + 0.30 * sin(360deg * Math.mod(mugenjo.tk / 8300.0 + 0.5, 1.0));
        }

        // ===== #34C THE CAKE-KINGDOM DRIFT — the dessert realm leaks into the castle: eight
        // sprinkles (one per pillar accent, the SAME ring as the HOME crest) falling the void,
        // each on its own clock with its own sway; nothing lands, nothing repeats in step. =====
        for sp in [
            { col: #28c8d8, cx: 0.09, sp: 13400.0, ph: 0.00, w: 3.5, h: 11.0 },
            { col: #ffb454, cx: 0.21, sp: 16800.0, ph: 0.41, w: 4.0, h:  9.0 },
            { col: #a78bfa, cx: 0.33, sp: 12100.0, ph: 0.73, w: 3.0, h: 12.0 },
            { col: #e6323c, cx: 0.45, sp: 18300.0, ph: 0.22, w: 4.5, h:  8.0 },
            { col: #5e8bff, cx: 0.57, sp: 14700.0, ph: 0.58, w: 3.5, h: 10.0 },
            { col: #2ecc71, cx: 0.69, sp: 11300.0, ph: 0.90, w: 3.0, h: 11.5 },
            { col: #f5c2e7, cx: 0.81, sp: 17500.0, ph: 0.12, w: 4.0, h:  8.5 },
            { col: #f39c12, cx: 0.93, sp: 15600.0, ph: 0.66, w: 3.5, h: 10.5 },
        ]: Rectangle {
            property <float> p: Math.mod(mugenjo.tk / sp.sp + sp.ph, 1.0);
            x: parent.width * Math.mod(sp.cx + 0.035 * sin(360deg * Math.mod(self.p * 2.0, 1.0)), 1.0);
            y: parent.height * (self.p * 1.08 - 0.04);
            width: sp.w * 1px; height: sp.h * 1px;
            border-radius: self.width / 2;
            background: sp.col;
            opacity: 0.26 * Math.sin(180deg * self.p);
        }

        // THE FROSTING GLINTS — three sugar motes twinkling on staggered clocks; candy dust
        // catching the lantern light for a breath, then gone.
        for g in [
            { cx: 0.26, cy: 0.24, sp: 5200.0, ph: 0.00 },
            { cx: 0.52, cy: 0.71, sp: 6700.0, ph: 0.37 },
            { cx: 0.78, cy: 0.38, sp: 5900.0, ph: 0.74 },
        ]: Rectangle {
            x: parent.width * g.cx; y: parent.height * g.cy;
            width: 5px; height: 5px;
            border-radius: 2.5px;
            background: #fff4d8;
            opacity: 0.30 * Math.max(0.0, sin(360deg * Math.mod(mugenjo.tk / g.sp + g.ph, 1.0)));
        }
    }
    title: "Yeah! Tortä";
    preferred-width: 440px;
    preferred-height: 900px;
    background: Monokuma.night;

    // ── The routing truth (host-readable + host-drivable) ──
    in-out property <string> active-tab: "home";  // "home" | "engine" | "dns" | "query"

    // ── THE ||| ADVANCED OVERLAY routing truth (1B — IN-SHELL navigation) ──
    // THE ANDROID SINGLE-SURFACE LAW (measured, lib.rs android_main): on-device, show()/hide()
    // window-swaps never re-take the one android surface — the last-constructed component owns it
    // (witnessed: the D2 swap hid the WHOLE app). So the ||| Advanced surface lives INSIDE the
    // shell as a visibility-switched overlay, and every navigation flip is shell-local state.
    in-out property <bool> advanced-open: false;
    // "pillars" | "general" — the rail's DNSCRYPT entry routes to the ③ DNS tab instead: the
    // shell's dc mount IS the one host-fed K5 pane (one typed authority, ONE fed mount on-device;
    // a second unfed DnscryptSection here would render fake defaults — the felt-truth law).
    in-out property <string> advanced-section: "pillars";
    in-out property <bool> advanced-drawer-open: true;
    // ── #60C-4 CARBON RENDERER SEAM — the host lifts carbon_bridge::surface frames
    // (RGBA8 through the assimilated carbonyl gfx primitives) into this texture.
    // FELT-TRUTH: carbon-frame-live stays false until a REAL frame has been fed;
    // the carbon-dash pane hides the surface, never a placeholder. ──
    in-out property <image> carbon-frame;
    in-out property <bool> carbon-frame-live: false;
    // ── #60B-3 CARBON LIVE ANALYTICS — host-fed off the SAME CarbonSurface the
    // seam renders through (frames genuinely finished, pixels genuinely written
    // by the assimilated primitives, real per-frame payload). FELT-TRUTH: the
    // chips row rides carbon-frame-live — no renderer, no numbers, never sample
    // defaults. ──
    in-out property <int> carbon-frames: 0;
    in-out property <int> carbon-px: 0;
    in-out property <int> carbon-kib: 0;
    // ── #60D ROUTING SEAM — host-fed status of the socket-layer probe: every
    // decision taken in carbon_bridge::route off LIVE engine reads (Beast QoS
    // phase, Underground reputation). FELT-TRUTH: empty until the host has
    // genuinely probed; the pane then swaps the pending line for the live one. ──
    in-out property <string> carbon-route: "";
    // ── #60C TEXT-MODE LANE v0 — the REAL browse pass: the GO bar fires
    // carbon-navigate(url) → the host fetches through the Kotlin bay (every
    // socket inside the YeAH Tortä tunnel) → carbon_bridge::engine parses →
    // the terminal page lands here. FELT-TRUTH: carbon-page-status stays ""
    // and carbon-page-lines stays empty until a fetch GENUINELY lands; a
    // failed fetch renders AS a failure (status −1 + the failure body). ──
    in-out property <string> carbon-url: "https://example.com";
    in-out property <string> carbon-page-status: "";
    in-out property <[string]> carbon-page-lines: [];
    callback carbon-navigate(string);
    // ── #60E SANDBOX HARDENING — host-fed status of the fs jail + per-site
    // permission map + the REAL process topology (isolation is a host-read
    // fact, never a module claim). FELT-TRUTH: empty until the host has
    // genuinely armed the jail and probed it. ──
    in-out property <string> carbon-sandbox: "";
    // ── #60F THE SPECIALS — host-fed truth of the userscript/extension engine:
    // landed flips only because the engine is genuinely compiled into this
    // build; the status line carries only REAL drop-in scan results. ──
    in-out property <bool> carbon-extension-engine-landed: false;
    in-out property <string> carbon-specials-status: "";
    callback carbon-install-extension-tapped();
    // ── #60G THE ROLE LANE — host-fed truth of the system default-browser role:
    // granted reads the REAL RoleManager.isRoleHeld(ROLE_BROWSER) through the
    // Kotlin layer; the status line carries only REAL request outcomes. ──
    in-out property <bool> carbon-role-granted: false;
    in-out property <string> carbon-role-status: "";
    callback carbon-set-default-browser-tapped();

    // ── Shell intents ──
    callback open-advanced();
    callback close-advanced();
    // The overlay's per-pillar private chips (DASHBOARD · SETTINGS |||) — host-routed intents
    // (the pillar surfaces embed as in-shell panes in the next wave; un-wired = silent no-op).
    callback open-pillar-dashboard(string);
    callback open-pillar-settings(string);
    // 2-FEED-Centauri (SETTINGS): the in-shell Centauri SETTINGS pane's typed WRITE intents, forwarded from
    // `censet` (CentauriSettings) up to the host. The host owns the drive to the armed engine (one-way to the
    // single source): cloak → the flat resolver cloak fn; seed → the durable SeedPolicy pref; warm-up → the
    // Object's bounded self-fill batch. Silent host-side no-op on a host/preview build (bridge unreachable).
    // (No strict / install: the CROWN is always-on LeakOnMiss and the catalog auto-arms — removed end-to-end.)
    callback centauri-cloak-toggled(bool);
    callback centauri-seed-policy-cycled();
    callback centauri-warm-up-now();
    // 2-FEED-Warden (SETTINGS): the in-shell Warden SETTINGS pane's typed WRITE intents, forwarded from `wset`
    // (WardenSettingsPane) up to the host. The host owns the drive to the canonical armed WardenObject (the SAME
    // instance the datapath consults, via WardenDatapathGate): posture → set_fail_closed; toggle → the 9-bit
    // universal toggles; add/remove-rule → install domain/CIDR rule-set; app mode/metered/pause → set_app_row.
    // (No trust intent: the Warden layer has no trust concept by design law — that surface is the Underground
    //  pillar's, not the firewall's.) Silent host-side no-op on a host/preview build (bridge unreachable).
    // ARM: the DASHBOARD crown control (the enforce seam the witness found dead) — host drives it to
    // `setWardenArmed` (pref persist -> VpnUtils.setWardenNativeEnabled -> WardenDatapathGate.setEnforced);
    // the pane re-feeds `warden-armed` from the live `configured` bit next tick, so a failed push snaps back.
    callback warden-arm(bool);
    callback warden-posture-changed(bool);
    callback warden-universal-toggled(string, bool);
    callback warden-add-rule(string, string, bool);
    callback warden-remove-rule(int);
    callback warden-app-mode-cycled(int);
    callback warden-app-metered-cycled(int);
    callback warden-app-pause-toggled(int);
    // ── W-D (#79) the per-app INSPECTOR popup intents (block-ladder). open(uid): uid<0 = browse, uid>=0
    // = drill into that app (host pulls its endpoint list + posture). block-selected(uid, mode): mode
    // 0=/32 · 1=/24 · 2=/16 · 3=country — the host rides the ladder over the selected endpoint set. ──
    callback warden-open-inspector(int);
    callback warden-close-inspector();
    callback warden-inspector-block-wifi(int, bool);
    callback warden-inspector-block-mobile(int, bool);
    callback warden-inspector-select-dest(string);
    callback warden-inspector-block-selected(int, int);

    // ── ||| MASKSOLVER SETTINGS intents (2-FEED-MaskSolver SETTINGS — masksolver_settings.slint) ──
    // The in-shell MaskSolver SETTINGS pane's controls ride these to the LIVE resolver process-globals via
    // engine_bridge → resolver_set_* (the SAME atomics the resolve hot-path reads — one instance, one truth).
    // The instant toggles (solve-ladder / all-servers / rebind / bogus-priv / proxy-dnssec / never-forward /
    // cache-rr) each drive a REAL Object setter now; the config-carried knobs (cache-cap / timeout / serve-stale
    // window / TTL clamps) STAGE onto the pane, then reapply-config lands them through resolver_configure.
    // Silent host-side no-op on a host/preview build (bridge unreachable). Fed back each 1s while shown.
    callback masksolver-solve-ladder-toggled(bool);
    callback masksolver-all-servers-toggled(bool);
    callback masksolver-rebind-protect-toggled(bool);
    callback masksolver-bogus-priv-toggled(bool);
    callback masksolver-proxy-dnssec-toggled(bool);
    callback masksolver-never-forward-toggled(bool);
    callback masksolver-cache-rr-toggled(bool);
    callback masksolver-serve-stale-toggled(bool);
    callback masksolver-cache-cap-stepped(int);
    callback masksolver-timeout-stepped(int);
    callback masksolver-serve-stale-secs-stepped(int);
    callback masksolver-ttl-floor-stepped(int);
    callback masksolver-ttl-ceiling-stepped(int);
    callback masksolver-rotation-cadence-stepped(int);
    callback masksolver-reapply-config();

    // 2-FEED-Rotation (SETTINGS): the Rotation SETTINGS pane's 5 intents. The wheel is HOST/Kotlin-owned (the
    // NO-FORK consensus — torta_core holds no live rotation cursor), so each rides a Kotlin destination, NOT a
    // resolver_set_*: pin → RESOLVER_ROTATION_ENABLED (inverted), rotate-now → the ACTION_ROTATE_RESOLVERS_NOW
    // intent, set/step-cadence → RESOLVER_ROTATION_CADENCE_MINUTES. Fed back each 1s while shown.
    callback rotation-settings-pin-toggled(bool);
    callback rotation-settings-rotate-now();
    callback rotation-settings-set-cadence(int);
    callback rotation-settings-cadence-stepped(int);

    // 2-FEED-Beast (SETTINGS): the Beast SETTINGS pane's 9 intents. torta_core has NO live tunable setter
    // (YeahController bakes max_window/free_thresh/compete_thresh at Beast::new/with_profile, yeah.rs:128),
    // so the 2 profiles + preset + 4 tunables are STAGED: a pick/step stages the value + marks profile-dirty;
    // reapply-profile COMMITS via a Beast rebuild (Beast::new(staged yeah, cake) + re-tune). Each staged value
    // is mirrored to a BEAST_* pref (the #51 durability law — a rebuild after restart re-reads them). Fed back
    // onto the bset-* aliases at startup + each 1s while the beast-settings section is shown.
    callback beast-settings-yeah-profile-picked(int);
    callback beast-settings-cake-profile-picked(int);
    callback beast-settings-preset-picked(int);
    callback beast-settings-cycle-ms-stepped(int);
    callback beast-settings-max-window-stepped(int);
    callback beast-settings-free-thresh-stepped(int);
    callback beast-settings-compete-thresh-stepped(int);
    callback beast-settings-expert-toggled(bool);
    callback beast-settings-reapply-profile();

    // 2-FEED-Inu (SETTINGS): the Wire Cake Inu SETTINGS pane's 9 intents. Unlike Beast (torta_core-owned), the
    // elevation grant flow is KOTLIN-owned (the ElevationManager / per-power GrantEngine / BootReapplyPolicy) —
    // each intent routes through the bridge to its real destination. pair-now/unpair drive the ADB pair+elevate
    // / clear; power-toggled sets GrantEngine PowerState.desired; boot-reapply/always-on/provider-pref/expert are
    // durable prefs (staged host-side + persisted by Kotlin, the #51 durability law); manual-pair carries the raw
    // Expert host:port:code. Fed back onto the iset-* aliases at startup + each 1s while inu-settings is shown.
    callback inu-settings-pair-now();
    callback inu-settings-unpair();
    callback inu-settings-power-toggled(string, bool);
    callback inu-settings-boot-reapply-toggled(bool);
    callback inu-settings-always-on-toggled(bool);
    callback inu-settings-provider-pref-cycled();
    callback inu-settings-manual-pair(string, string, string);
    callback inu-settings-expert-toggled(bool);

    // ── ① HOME forwarding (home_tab.slint) ──
    in-out property <bool> home-host-live <=> home.host-live;
    in-out property <bool> engine-running <=> home.engine-running;
