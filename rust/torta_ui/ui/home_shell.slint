    // ★ N-dial CLASSIFIED — the WHY behind the total above. Without these four forwardings the
    // properties exist on the engine tab but never reach TortaShell, so the Rust feed cannot set
    // them and the tiles would render a permanent 0 while the engine counted correctly. That is a
    // silent-zero panel, which is worse than no tile at all.
    in-out property <int> fwd-dial-refused <=> eng.fwd-dial-refused;
    in-out property <int> fwd-dial-unreachable <=> eng.fwd-dial-unreachable;
