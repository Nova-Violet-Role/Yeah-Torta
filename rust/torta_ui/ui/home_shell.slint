                    // 2-FEED-Rotation (SETTINGS): the Rotation pillar SETTINGS (THE WHEEL'S CONTROLS) mounted
                    // IN-SHELL (the rotation-settings section) — reached via ||| → PILLARS → ROTATION settings
                    // chip. The 5 controls are HOST/Kotlin-owned (the NO-FORK consensus — torta_core holds no
                    // live rotation cursor): pin → RESOLVER_ROTATION_ENABLED (inverted), rotate-now → the
                    // ACTION_ROTATE_RESOLVERS_NOW intent, set/step-cadence → RESOLVER_ROTATION_CADENCE_MINUTES.
                    // The host feeds the current posture onto the `rset-*` aliases at startup + each second while
                    // shown; close-settings (or the PILLARS rail) returns. RotationSettingsPane inherits Rectangle
                    // so it embeds on the single android surface (the MaskSolverSettingsPane precedent). Expert
                    // reveal is self-managed by the pane (it flips its own expert-open).
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        visible: root.advanced-section == "rotation-settings";
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            rsettings := RotationSettingsPane {
                                pin-toggled(on) => { root.rotation-settings-pin-toggled(on); }
                                rotate-now() => { root.rotation-settings-rotate-now(); }
                                set-cadence(secs) => { root.rotation-settings-set-cadence(secs); }
                                cadence-stepped(dir) => { root.rotation-settings-cadence-stepped(dir); }
                                // expert-toggled self-managed by the pane (it flips its own expert-open reveal).
                                close-settings() => { root.advanced-section = "pillars"; }
                            }
                        }
                    }

                    // 2-FEED-Beast (SETTINGS): the Beast pillar SETTINGS (THE FLOW-ENGINE TUNE) mounted IN-SHELL
                    // (the beast-settings section) — reached via ||| → PILLARS → BEAST settings chip. The 2 profiles
                    // + preset + 4 tunables are STAGED (torta_core has no live tunable setter — YeahController bakes
                    // them at Beast::new/with_profile); reapply-profile COMMITS via a Beast rebuild. Each staged value
                    // mirrors to a BEAST_* pref (the #51 durability law). The host feeds the live posture onto the
                    // `bset-*` aliases at startup + each second while shown; close-settings (or the PILLARS rail)
                    // returns. BeastSettingsPane inherits Rectangle so it embeds on the single android surface. The
                    // expert reveal is self-managed by the pane (it flips its own expert-open).
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        visible: root.advanced-section == "beast-settings";
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            bsettings := BeastSettingsPane {
                                yeah-profile-picked(v) => { root.beast-settings-yeah-profile-picked(v); }
                                cake-profile-picked(v) => { root.beast-settings-cake-profile-picked(v); }
                                preset-picked(v) => { root.beast-settings-preset-picked(v); }
                                cycle-ms-stepped(d) => { root.beast-settings-cycle-ms-stepped(d); }
                                max-window-stepped(d) => { root.beast-settings-max-window-stepped(d); }
                                free-thresh-stepped(d) => { root.beast-settings-free-thresh-stepped(d); }
                                compete-thresh-stepped(d) => { root.beast-settings-compete-thresh-stepped(d); }
                                expert-toggled(on) => { root.beast-settings-expert-toggled(on); }
                                reapply-profile() => { root.beast-settings-reapply-profile(); }
                                close-settings() => { root.advanced-section = "pillars"; }
                            }
                        }
                    }

                    // 4-FIX round 3 · 2-FEED-Warden: the Warden pillar DASHBOARD (THE FIREWALL COURTROOM)
                    // mounted IN-SHELL (the warden-dash section) — reached via ||| → PILLARS → WARDEN
                    // dashboard chip. Closes the witness finding that the WARDEN dashboard tap was a silent
                    // no-op: WardenPane inherits Rectangle so it embeds on the single android surface (the
                    // same law MaskSolver/Centauri/Beast/Rotation follow). Host-fed from the live WardenObject.
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        visible: root.advanced-section == "warden-dash";
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            // The dashboard's write surface (the witness found this body EMPTY — the arm
                            // chip, the tap-to-flip toggles + the matrix cycle were all silent no-ops). The
                            // crown arm rides its own `warden-arm`; the universal-toggle + matrix taps REUSE
                            // the SAME root callbacks the settings pane drives (one Kotlin path, no divergence
                            // — the matrix ordinal is ignored: the host owns the cycle order).
                            wdash := WardenPane {
                                arm-warden(on) => { root.warden-arm(on); }
                                set-universal-toggle(key, on) => { root.warden-universal-toggled(key, on); }
                                cycle-app-mode(uid, ord) => { root.warden-app-mode-cycled(uid); }
                                close-dashboard() => { root.advanced-section = "pillars"; }
                                // W-D — the per-app inspector popup (block-ladder). The overlay lives inside
                                // this pane (single-surface law); the taps ride out as root intents the host wires.
                                open-inspector(uid) => { root.warden-open-inspector(uid); }
                                close-inspector() => { root.warden-close-inspector(); }
                                inspector-block-wifi-toggle(uid, on) => { root.warden-inspector-block-wifi(uid, on); }
                                inspector-block-mobile-toggle(uid, on) => { root.warden-inspector-block-mobile(uid, on); }
                                inspector-select-dest(ip) => { root.warden-inspector-select-dest(ip); }
                                inspector-block-selected(uid, mode) => { root.warden-inspector-block-selected(uid, mode); }
                            }
                        }
                    }

                    // 2-FEED-Warden (SETTINGS): the Warden pillar SETTINGS (the sovereign rules editor) mounted
                    // IN-SHELL (the warden-settings section) — reached via ||| → PILLARS → WARDEN settings chip.
                    // Unlike the read-only dashboard, this pane WRITES the canonical live WardenObject (the SAME
                    // instance the datapath consults, via WardenDatapathGate): each control fires a typed `warden-*`
                    // callback the host drives to the armed Object setter (one-way to the single source). The host
                    // feeds the current armed state onto the `ws-*` aliases at startup + each second while shown;
                    // close-settings (or the PILLARS rail) returns. WardenSettingsPane inherits Rectangle so it
                    // embeds on the single android surface (the CentauriSettingsPane precedent).
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        visible: root.advanced-section == "warden-settings";
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            wset := WardenSettingsPane {
                                posture-changed(v) => { root.warden-posture-changed(v); }
                                universal-toggled(key, on) => { root.warden-universal-toggled(key, on); }
                                add-rule(kind, text, wildcard) => { root.warden-add-rule(kind, text, wildcard); }
                                remove-rule(idx) => { root.warden-remove-rule(idx); }
                                app-mode-cycled(uid) => { root.warden-app-mode-cycled(uid); }
                                app-metered-cycled(uid) => { root.warden-app-metered-cycled(uid); }
                                app-pause-toggled(uid) => { root.warden-app-pause-toggled(uid); }
                                close-settings() => { root.advanced-section = "pillars"; }
                            }
                        }
                    }

                    // 4-FIX round 3 · 2-FEED-Inu: the Wire Cake Inu pillar DASHBOARD (THE LOYAL HOUND)
                    // mounted IN-SHELL (the inu-dash section) — reached via ||| → PILLARS → WIRE CAKE INU
                    // dashboard chip. Closes the witness finding that the INU dashboard tap was a silent
                    // no-op: InuPane inherits Rectangle so it embeds on the single android surface. Host-fed
                    // from the live InuStore spike posture.
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        visible: root.advanced-section == "inu-dash";
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            idash := InuPane { }
                        }
                    }

                    // 2-FEED-Inu (SETTINGS): the Wire Cake Inu pillar SETTINGS (the elevation surface — pair ·
                    // protect · keep) mounted IN-SHELL (the inu-settings section) — reached via ||| → PILLARS →
                    // WIRE CAKE INU settings chip. The sixth + final per-pillar SETTINGS surface (the #23 closer).
                    // Unlike Beast (torta_core-staged), the grant flow is KOTLIN-owned: each control fires a typed
                    // `inu-settings-*` callback the host drives to the ElevationManager / per-power GrantEngine /
                    // BootReapplyPolicy (one-way to the single source). The host feeds the live InuStore posture +
                    // the durability prefs onto the `iset-*` aliases at startup + each second while shown;
                    // close-settings (or the PILLARS rail) returns. InuSettingsPane inherits Rectangle so it embeds
                    // on the single android surface (the BeastSettingsPane precedent).
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        visible: root.advanced-section == "inu-settings";
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            isettings := InuSettingsPane {
                                pair-now() => { root.inu-settings-pair-now(); }
                                unpair() => { root.inu-settings-unpair(); }
                                power-toggled(id, on) => { root.inu-settings-power-toggled(id, on); }
                                boot-reapply-toggled(on) => { root.inu-settings-boot-reapply-toggled(on); }
                                always-on-toggled(on) => { root.inu-settings-always-on-toggled(on); }
                                provider-pref-cycled() => { root.inu-settings-provider-pref-cycled(); }
                                manual-pair(h, p, c) => { root.inu-settings-manual-pair(h, p, c); }
                                expert-toggled(on) => { root.inu-settings-expert-toggled(on); }
                                close-settings() => { root.advanced-section = "pillars"; }
                            }
                        }
                    }

                    // #15 UNDERGROUND H — the licence court's OWN room (the "underground-dash"
                    // section; the census scalars hub off the SAME ug-* truths the host feeds).
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        visible: root.advanced-section == "underground-dash";
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            ugdash := UndergroundDashboardPane {
                                armed <=> root.ug-armed;
                                total <=> root.ug-total;
                                recorded <=> root.ug-recorded;
                                recovered <=> root.ug-recovered;
                                teeth <=> root.ug-teeth;
                                sequestrated <=> root.ug-sequestrated;
                                probation <=> root.ug-probation;
                                trusted <=> root.ug-trusted;
                                distrusted <=> root.ug-distrusted;
                                trust-status <=> root.ug-trust-status;
                                trust-input <=> root.ug-trust-input;
                                set-verdict(host, code) => { root.underground-set-verdict(host, code); }
                            }
                        }
                    }

                    // #15 UNDERGROUND H — the tunable law (the "underground-settings" section).
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        visible: root.advanced-section == "underground-settings";
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            ugsettings := UndergroundSettingsPane {
                                armed <=> root.ug-armed;
                                save-toml(text) => { root.underground-save-toml(text); }
                                detection-toggled(name, on) => { root.underground-detection-toggled(name, on); }
                                reset-reputation() => { root.underground-reset-reputation(); }
                                reload() => { root.underground-reload-law(); }
                            }
                        }
                    }

                    // ---- THE DRAWER DISMISS SCRIM — tap ANYWHERE in the content to close the |||
                    //      rail, instead of having to travel back and re-click the ||| button.
                    //
                    //      MEASURED COMPLAINT: "you have to re-click it instead of tapping on another
                    //      area to close it". Every phone drawer in existence dismisses on an outside
                    //      tap; ours did not, so the ||| button was the ONLY exit and it sits in the
                    //      far corner — the worst place to reach one-handed on a 6" screen.
                    //
                    //      DECLARED TRADE-OFF, because this is not free: while the rail is open this
                    //      scrim SWALLOWS the first tap on the content. That is the standard drawer
                    //      contract (tap-to-dismiss consumes the tap, it does not fall through), and
                    //      it is why the scrim is `visible` ONLY while the rail is open — with the
                    //      rail closed it does not exist and cannot intercept anything. A tap that
                    //      both dismisses AND activates the control underneath is not expressible
                    //      here, and would be worse UX anyway: it fires a control the user could not
                    //      see the moment they aimed at it.
                    //
                    //      It is the LAST child on purpose: Slint paints later siblings on top, so a
                    //      scrim declared earlier would sit UNDER the panes (which are width/height
                    //      100%) and never receive a tap at all — a dismissal that silently never
                    //      fires, which is worse than the bug it replaces.
                    TouchArea {
                        width: 100%;
                        height: 100%;
                        visible: root.advanced-drawer-open;
                        clicked => { root.advanced-drawer-open = false; }
                    }
                }
            }
        }
    }

    // =============================================================================================
    // #35 THE NOTIFY-BAR — the always-on surveillance strip (LAST root child = z-topmost; it
    // survives the ||| overlay — the one surface that never leaves the screen). Host-fed truth
    // (felt-truth law): un-fed = honest "—" / "no live read yet"; the matrix reads the SAME
    // pillar-chips model the HOME tab + ||| overlay read — one row source, three views, zero drift.
    // =============================================================================================
    in property <bool> notify-live: false;
    in property <string> notify-dl: "—";
    in property <string> notify-ul: "—";
    in property <bool> notify-engine-running: false;
    in-out property <bool> notify-expanded: false;
    callback notify-toggle-engine();
    // #59 DONATE — engine-truth link (torta_core::donate); host re-asserts every tick
    in property <string> notify-donate-url: "ko-fi.com/saimonokuma";
    callback notify-open-donate();
    // #59 D2 — the D1c mirror's escalation: fires ONLY from carbon-dash (the pane is already
    // on screen, re-entry is a no-op) → the host routes it to the REAL `ACTION_VIEW` intent
    // through `TortaSlintBridge.openDonate` (user's default browser, engine-truth URL).
    callback carbon-donate-direct();
    // #60C-b THE ESCAPE HATCH, MADE REACHABLE. The DONATE tap above lands IN-APP through the
    // text-mode lane and STAYS that way — the user directive forbids an AUTOMATIC external intent,
    // and this does not change that. But the text lane renders text: a Ko-Fi payment page cannot be
    // completed in it. So the system browser stays available as an EXPLICIT, user-initiated choice,
    // which is a different thing from the app deciding to leave on its own.
    //
    // Before this, `open_donate_intent` was carrying `#[allow(dead_code)]` and was documented as an
    // escape hatch that nothing could reach. An escape hatch nobody can open is not a hatch.
    callback carbon-donate-external();

    // BUGS2 #64 (1) — the in-app bottom NotifyBar mount is REMOVED: the Notify-Bar truth now
    // lives on the REAL Android foreground notification (TortaSlintBridge.trafficSnapshot →
    // ModulesServiceNotificationManager.updateNotification — same TrafficStats well, felt-truth
    // law intact). The notify-* root properties/callbacks above stay: the host still feeds them
    // (one row source, zero drift) and the ||| overlay + HOME tab keep reading the same model.
}
