    in-out property <int> rdash-cadence-minutes <=> rdash.cadence-minutes;
    in-out property <bool> rdash-engine-running <=> rdash.engine-running;
    in-out property <int> rdash-rotate-status <=> rdash.rotate-status;
    callback rdash-rotate-now <=> rdash.rotate-now;
    callback rdash-rotation-toggled <=> rdash.rotation-toggled;
    callback rdash-cadence-picked <=> rdash.cadence-picked;
    // ── #22 s5A: PICK FILTER (the ONE dnscrypt-toml authority) + POOL SHAPE (GEEK-clamped rotation prefs) ──
    in-out property <bool> rdash-crit-nolog <=> rdash.crit-nolog;
    in-out property <bool> rdash-crit-dnssec <=> rdash.crit-dnssec;
    in-out property <bool> rdash-crit-nofilter <=> rdash.crit-nofilter;
    in-out property <bool> rdash-crit-ipv4 <=> rdash.crit-ipv4;
    in-out property <bool> rdash-crit-ipv6 <=> rdash.crit-ipv6;
    in-out property <bool> rdash-crit-proto-dnscrypt <=> rdash.crit-proto-dnscrypt;
    in-out property <bool> rdash-crit-proto-doh <=> rdash.crit-proto-doh;
    in-out property <bool> rdash-crit-proto-odoh <=> rdash.crit-proto-odoh;
    in-out property <bool> rdash-crit-sysdns <=> rdash.crit-sysdns;
    in-out property <int> rdash-max-servers <=> rdash.max-servers;
    in-out property <int> rdash-max-relays <=> rdash.max-relays;
    callback rdash-criteria-toggled <=> rdash.criteria-toggled;
    callback rdash-max-servers-stepped <=> rdash.max-servers-stepped;
    callback rdash-max-relays-stepped <=> rdash.max-relays-stepped;

    // ── ||| ROTATION SETTINGS forwarding (2-FEED-Rotation SETTINGS — rotation_settings.slint RotationSettingsPane) ──
    // The in-shell mount of the Rotation pillar SETTINGS (the "rotation-settings" advanced section). The host
    // pushes the CURRENT wheel posture (family/index over the JNI `live_rotation_state` cursor + the
    // RESOLVER_ROTATION_* prefs) onto the `rset-` aliases; the user's edit intents flow back out as the
    // `rotation-settings-*` callbacks (each host-wired to its Kotlin destination). `rset-` prefixed so the
    // names never collide with the `rdash-` dashboard twin.
    in-out property <bool> rset-configured <=> rsettings.configured;
    in-out property <string> rset-rotation-family <=> rsettings.rotation-family;
    in-out property <int> rset-rotation-index <=> rsettings.rotation-index;
    in-out property <int> rset-cadence-secs <=> rsettings.cadence-secs;
    in-out property <bool> rset-pinned <=> rsettings.pinned;
    in-out property <bool> rset-expert-open <=> rsettings.expert-open;

    // ── ||| BEAST SETTINGS forwarding (2-FEED-Beast SETTINGS — beast_settings.slint BeastSettingsPane) ──
    // The in-shell mount of the Beast pillar SETTINGS (the "beast-settings" advanced section). The host pushes
    // the LIVE flow-engine posture (the engine Beast handle's BeastSnapshot yeah_profile/cake_profile + the
    // BEAST_* staged prefs for preset + the 4 tunables + the live cwnd/mode/base_rtt witnesses) onto the `bset-`
    // aliases; the user's edit intents flow back out as the `beast-settings-*` callbacks. `bset-` prefixed so
    // the names never collide with the `bdash-` Beast dashboard twin.
    in-out property <int> bset-yeah-profile <=> bsettings.yeah-profile;
    in-out property <int> bset-cake-profile <=> bsettings.cake-profile;
    in-out property <int> bset-preset <=> bsettings.preset;
    in-out property <int> bset-cycle-ms <=> bsettings.cycle-ms;
    in-out property <int> bset-max-window <=> bsettings.max-window;
    in-out property <int> bset-free-thresh-milli <=> bsettings.free-thresh-milli;
    in-out property <int> bset-compete-thresh-milli <=> bsettings.compete-thresh-milli;
    in-out property <bool> bset-tunable-clamped <=> bsettings.tunable-clamped;
    in-out property <bool> bset-profile-dirty <=> bsettings.profile-dirty;
    in-out property <bool> bset-expert-open <=> bsettings.expert-open;
    in-out property <int> bset-cwnd <=> bsettings.cwnd;
    in-out property <string> bset-mode <=> bsettings.mode;
    in-out property <float> bset-base-rtt-ms <=> bsettings.base-rtt-ms;

    // ── ||| WIRE CAKE INU SETTINGS forwarding (2-FEED-Inu SETTINGS — inu_settings.slint InuSettingsPane) ──
    // The in-shell mount of the Inu pillar SETTINGS (the "inu-settings" advanced section — pair · protect · keep).
    // The host pushes the LIVE elevation posture: from the InuStore snapshot (paired / active-provider /
    // elevation-status / expert-open / the per-power protect map + the folded held/desired/drift counts) and the
    // Kotlin-owned durability prefs (boot-reapply-armed / always-on / provider-pref, staged host-side). The user's
    // edit intents flow back out as the `inu-settings-*` callbacks to the Kotlin ElevationManager/GrantEngine.
    // `iset-` prefixed so the names never collide with the `idash-` Inu dashboard twin.
    // The demo marker MUST be forwarded HERE, on the pane actually mounted at :2350. The #97
    // dashboard fix computed its flag correctly and still rendered nothing on device for exactly
    // this reason — the alias was missing on the real mount. A property the host sets but no mount
    // forwards is set on an object nobody renders.
    in-out property <bool> iset-demo-posture <=> isettings.demo-posture;
    in-out property <bool> iset-configured <=> isettings.configured;
    in-out property <bool> iset-paired <=> isettings.paired;
    in-out property <string> iset-paired-label <=> isettings.paired-label;
    in-out property <int> iset-active-provider <=> isettings.active-provider;
    in-out property <int> iset-elevation-status <=> isettings.elevation-status;
    in-out property <bool> iset-always-on <=> isettings.always-on;
    in-out property <bool> iset-boot-reapply-armed <=> isettings.boot-reapply-armed;
    in-out property <int> iset-provider-pref <=> isettings.provider-pref;
    in-out property <bool> iset-expert-open <=> isettings.expert-open;
    in-out property <int> iset-powers-held <=> isettings.powers-held;
    in-out property <[PowerToggleRow]> iset-powers <=> isettings.powers;
    in-out property <string> iset-draft-host <=> isettings.draft-host;
    in-out property <string> iset-draft-port <=> isettings.draft-port;
    in-out property <string> iset-draft-code <=> isettings.draft-code;
    in-out property <int> iset-desired-count <=> isettings.desired-count;
    in-out property <int> iset-drift-desired-count <=> isettings.drift-desired-count;

    // ── ||| WARDEN DASHBOARD forwarding (4-FIX round 3 · 2-FEED-Warden — warden.slint WardenPane) ──
    // The in-shell mount of the Warden pillar dashboard (the "warden-dash" advanced section). The host
    // pushes each field from the live `WardenObject::snapshot()` typed `WardenSnapshot`; `wdash-` prefixed
    // so the names never collide with HOME's own props. The pane derives its over-block hunt + trust band
    // internally — the shell only feeds the inputs. Fed once at startup from the armed spike posture (the
    // static spike does not change ⇒ no refresh Timer needed; an honest cold read ⇒ the honest baseline).
    in-out property <int> wdash-allow-count <=> wdash.allow-count;
    in-out property <int> wdash-deny-count <=> wdash.deny-count;
    in-out property <int> wdash-deny-by-toggle <=> wdash.deny-by-toggle;
    in-out property <int> wdash-deny-by-app <=> wdash.deny-by-app;
    in-out property <int> wdash-deny-by-universal <=> wdash.deny-by-universal;
    in-out property <int> wdash-deny-by-dns <=> wdash.deny-by-dns;
    in-out property <int> wdash-domain-rules <=> wdash.domain-rules;
    in-out property <int> wdash-cidr-rules <=> wdash.cidr-rules;
    in-out property <int> wdash-universal-rules <=> wdash.universal-rules;
    in-out property <int> wdash-app-rows <=> wdash.app-rows;
    in-out property <int> wdash-cache-entries <=> wdash.cache-entries;
    in-out property <bool> wdash-policy-loaded <=> wdash.policy-loaded;
    in-out property <bool> wdash-fail-closed <=> wdash.fail-closed;
    in-out property <string> wdash-trust-source-name <=> wdash.trust-source-name;
    in-out property <int> wdash-trust-score <=> wdash.trust-score;
    in-out property <int> wdash-trust-cdn-overlap <=> wdash.trust-cdn-overlap;
    in-out property <bool> wdash-trust-armed <=> wdash.trust-armed;
    in-out property <bool> wdash-lockdown-armed <=> wdash.lockdown-armed;
    // A6 — the LIVE datapath enforce bit (host feeds it from `liveWardenStats.configured` =
    // WardenDatapathGate.enforced()); the crown pill reads it, the arm-warden tap re-drives it.
    in-out property <bool> wdash-warden-armed <=> wdash.warden-armed;
    in-out property <[AppRow]> wdash-app-matrix <=> wdash.app-matrix;
    // A6 seam close — the 9 TIER-2 chips READ feed (the write callback :1398 was wired while this
    // read alias was missing, so the pane rendered "the bridge is silent" forever, even armed).
    in-out property <[ToggleRow]> wdash-universal-toggles <=> wdash.universal-toggles;
    // A5 slice-5 — the LIVE FLOWS docket (the ConnTracker ring): refreshed by a 1s host Timer WHILE
    // the warden-dash section is shown (the Centauri/MaskSolver refresh law — the ring DOES change).
    in-out property <[FlowRow]> wdash-live-flows <=> wdash.live-flows;
    in-out property <int> wdash-flow-total <=> wdash.flow-total;
    out property <int> wdash-flows-shown <=> wdash.flows-shown;
    // ── W-D (#79) the per-app INSPECTOR forwarding (warden.slint WardenPane overlay). The host feeds the
    // app browser every tick (`wdash-inspector-apps`) and, on open, the focused app's endpoint list +
    // posture; the selection lives in the dest model (a select tap re-feeds it with the flipped bit). ──
    in-out property <bool> wdash-inspector-open <=> wdash.inspector-open;
    in-out property <[InspectorAppRow]> wdash-inspector-apps <=> wdash.inspector-apps;
    in-out property <int> wdash-inspector-uid <=> wdash.inspector-uid;
    in-out property <string> wdash-inspector-app-name <=> wdash.inspector-app-name;
    in-out property <bool> wdash-inspector-block-wifi <=> wdash.inspector-block-wifi;
    in-out property <bool> wdash-inspector-block-mobile <=> wdash.inspector-block-mobile;
    in-out property <[InspectorDestRow]> wdash-inspector-dests <=> wdash.inspector-dests;
    in-out property <string> wdash-inspector-geo-blocks <=> wdash.inspector-geo-blocks;
    in-out property <int> wdash-inspector-selected-count <=> wdash.inspector-selected-count;
    out property <int> wdash-inspector-apps-shown <=> wdash.inspector-apps-shown;
    out property <int> wdash-inspector-dests-shown <=> wdash.inspector-dests-shown;

    // ── ||| WIRE CAKE INU DASHBOARD forwarding (4-FIX round 3 · 2-FEED-Inu — inu.slint InuPane) ──
    // The in-shell mount of the Inu pillar dashboard (the "inu-dash" advanced section). The host pushes each
    // field from the live `InuStore` snapshot; `idash-` prefixed so the names never collide. The pane derives
    // its elevation-fault hunt + collar crown internally — the shell only feeds inputs. The pane's Pair /
    // Re-check / Advanced buttons stay un-wired here (a silent no-op — the felt-truth law; the elevation
    // action path is a later wave), so the dashboard OPENS + shows the live spike posture, never a fake drive.
    // #97 — the demo marking must be forwarded HERE, at the shell mount, or the shipped panel can
    // never be told. The standalone `InuDashboard` window carries its own copy, but that window is
    // the witness/proof mount; the ADVANCED section the user actually opens is this `InuPane`. I
    // wired the window first and the banner did not appear on device — because this line was
    // missing. Same law as the four `fwd-dial-*` forwardings: a property must be forwarded at EVERY
    // mount, and a mount that is not forwarded is a panel that silently cannot be told.
    in-out property <bool> idash-demo-posture <=> idash.demo-posture;
    in-out property <bool> idash-configured <=> idash.configured;
    in-out property <int> idash-elevation-status <=> idash.elevation-status;
    in-out property <int> idash-active-provider <=> idash.active-provider;
    in-out property <bool> idash-paired <=> idash.paired;
    in-out property <string> idash-paired-label <=> idash.paired-label;
    in-out property <string> idash-status-detail <=> idash.status-detail;
    in-out property <int> idash-powers-held <=> idash.powers-held;
    in-out property <int> idash-powers-total <=> idash.powers-total;
    in-out property <int> idash-drift-prone-held <=> idash.drift-prone-held;
    in-out property <bool> idash-boot-reapply-armed <=> idash.boot-reapply-armed;
    in-out property <[PowerRow]> idash-powers <=> idash.powers;
    in-out property <[InuLogRow]> idash-recent-events <=> idash.recent-events;

    VerticalLayout {
        // ---- THE TOP STRIP: the ||| door + the identity + the live engine dot ----
        Rectangle {
            height: 54px;
            background: Monokuma.coal;
            HorizontalLayout {
                padding: 5px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                Rectangle {
                    width: 44px;
                    border-radius: 8px;
                    background: Monokuma.slate;
                    Text {
                        text: "|||";
                        color: Monokuma.bone;
                        font-size: 18px;
                        font-weight: 900;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        // 1B: the flip is SHELL-LOCAL (the single-surface law — no window-swap);
                        // the callback still fires so the host refreshes the fed mounts.
                        clicked => {
                            root.advanced-open = true;
                            root.open-advanced();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "YEAH! TORTÄ";
                        color: Monokuma.bone;
                        font-size: 16px;
                        font-weight: 900;
                    }
                    Text {
                        text: root.active-tab == "engine" ? "the Tortä engine"
                            : root.active-tab == "dns" ? "the DNSCrypt section"
                            : root.active-tab == "query" ? "the query feed"
                            : "the sovereign DNS home";
                        color: Monokuma.ash;
                        font-size: 10px;
                    }
                }
                Rectangle { }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: root.engine-running ? Monokuma.safe : Monokuma.iron;
                        border-width: 1px;
                        border-color: root.engine-running ? Monokuma.safe : Monokuma.dim;
                    }
                }
            }
        }

        // ---- (BUGS2 #64) ← HOME RETURN STRIP — with the 4-tab bar retired, off-home tabs get
        // a one-tap return reflex WITHOUT opening the ||| burger (the burger stays the ONE
        // deep-nav authority; this strip only ever routes home). Visible only off-home. ----
        if root.active-tab != "home": Rectangle {
            height: 30px;
            background: Monokuma.coal;
            border-width: 1px;
            border-color: Monokuma.iron;
            TouchArea {
                clicked => { root.active-tab = "home"; }
            }
            HorizontalLayout {
                padding-left: 14px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "← HOME";
                        color: Monokuma.bone;
                        font-size: 12px;
                        font-weight: 800;
                    }
                }
            }
        }

        // ---- THE CONTENT REGION — four visibility-switched overlays (the D2 alias law) ----
        Rectangle {
            vertical-stretch: 1;
            background: Monokuma.night;

            ScrollView {
                width: 100%;
                height: 100%;
                visible: root.active-tab == "home";
                viewport-width: self.visible-width;
                VerticalLayout {
                    home := HomeTab {
                        // A pillar chip: open the in-shell ADVANCED overlay at PILLARS + tell the host.
                        open-pillar(id) => {
                            root.advanced-section = "pillars";
                            root.advanced-open = true;
                            root.open-pillar(id);
                        }
                    }
                }
            }

            ScrollView {
                width: 100%;
                height: 100%;
                visible: root.active-tab == "engine";
                viewport-width: self.visible-width;
                VerticalLayout {
                    eng := EngineTab { }
                }
            }

            ScrollView {
                width: 100%;
                height: 100%;
                visible: root.active-tab == "dns";
                viewport-width: self.visible-width;
                VerticalLayout {
                    dc := DnscryptSection { }
                }
            }

            // QUERY manages its own virtualized ListView — mounted bare (no outer ScrollView).
            Rectangle {
                width: 100%;
                height: 100%;
                visible: root.active-tab == "query";
                q := QueryTab {
                    width: 100%;
                    height: 100%;
                }
            }
        }

        // ---- (BUGS2 #64) THE 4-TAB BAR IS RETIRED — every route now lives in the ||| burger
        // (HOME chip, DNSCRYPT chip, ENGINE ROOM chip, QUERY chip). The `active-tab` router and
        // all four content mounts above are UNCHANGED: the ENGINE surface still uniquely hosts
        // the FORWARDER (`fwd-*`) + UNDERGROUND (`ug-*`) cards, QUERY its virtualized feed. ----
    }

    // =============================================================================================
    // THE ||| ADVANCED OVERLAY (1B) — the D2 burger surface REHOMED INSIDE the shell.
    // The single-surface law makes the on-device window-swap impossible (witnessed: hide() hid the
    // whole app), so the ||| door now lifts this full-screen overlay over the 4-tab Home: the
    // per-pillar private tabs (the SAME PillarTab rows + the SAME pillar-chips model the HOME tab
    // reads — one row source, two views, zero drift) + the GENERAL section pane; the rail's
    // DNSCRYPT entry routes to the ③ DNS tab — the shell's one host-fed K5 mount.
    // =============================================================================================
    Rectangle {
        width: 100%;
        height: 100%;
        visible: root.advanced-open;
        background: ThemeBook.burger.ground;

        // #36 THE DESCENT — the Hashira-dive ambient under the GLASS WIRE panels
        // (the in-shell ||| PILLARS overlay mount — same wash as the D2 window).
        DescentWash { width: 100%; height: 100%; }

        VerticalLayout {
            // ---- The overlay top strip: the ||| drawer toggle + the identity + the TRUE-✕ close
            //      (#33: ThemeBook.burger chrome — the ADVANCED title wears the duality accent).
            //      #GLOSS (the hand, 2026-07-22): glossy · chromatic · hypnotic — a pillar-spectrum
            //      aurora breathing along the base, a glass sheen, a drifting specular streak.
            //      Pure animation-tick sines; zero timers; nothing intercepts input. ----
            Rectangle {
                height: 54px;
                background: ThemeBook.burger.floor;
                // the glass sheen (top-lit gloss)
                Rectangle {
                    y: 0px;
                    height: parent.height * 0.5;
                    background: @linear-gradient(180deg, #ffffff.with-alpha(0.08) 0%, #ffffff.with-alpha(0.0) 100%);
                }
                // the drifting specular streak — slow, hypnotic
                Rectangle {
                    property <float> drift: Math.sin(360deg * (animation-tick() / 7.5s));
                    x: parent.width * (0.5 + 0.42 * self.drift) - 30px;
                    width: 60px;
                    background: @linear-gradient(100deg, #ffffff.with-alpha(0.0) 0%, #ffffff.with-alpha(0.07) 50%, #ffffff.with-alpha(0.0) 100%);
                }
                // the pillar-spectrum AURORA line — inu teal · beast amber · masksolver violet ·
                // rotation blue, phase-mixing forever (the chromatic-hypnotic signature)
                Rectangle {
                    property <float> ph: 0.5 + 0.5 * Math.sin(360deg * (animation-tick() / 5.2s));
                    property <color> ca: #3fd4c2;
                    property <color> cb: #ffb454;
                    property <color> cc: #a78bfa;
                    property <color> cd: #5e8bff;
                    y: parent.height - 3px;
                    height: 3px;
                    background: @linear-gradient(90deg,
                        self.ca.mix(self.cc, self.ph) 0%,
                        self.cb.mix(self.ca, self.ph) 33%,
                        self.cc.mix(self.cb, self.ph) 66%,
                        self.cd.mix(self.cc, self.ph) 100%);
                }
                HorizontalLayout {
                    padding: 5px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    Rectangle {
                        width: 44px;
                        border-radius: 8px;
                        background: root.advanced-drawer-open ? ThemeBook.burger.panel : transparent;
                        Text {
                            text: "|||";
                            color: ThemeBook.burger.bright;
                            font-size: 18px;
                            font-weight: 900;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => { root.advanced-drawer-open = !root.advanced-drawer-open; }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "ADVANCED";
                            color: ThemeBook.burger.accent;
                            font-size: ThemeBook.burger.title-size;
                            font-weight: ThemeBook.burger.title-weight;
                        }
                        Text {
                            text: root.advanced-section == "general" ? "general settings"
                                : root.advanced-section == "ms-dash" ? "the MaskSolver dashboard"
                                : root.advanced-section == "ms-settings" ? "the MaskSolver settings"
                                : root.advanced-section == "centauri-dash" ? "the Centauri dashboard"
                                : root.advanced-section == "centauri-settings" ? "the Centauri settings"
                                : root.advanced-section == "forwarder-dash" ? "the Netstack Forwarder docket"
                                : root.advanced-section == "beast-dash" ? "the Beast dashboard"
                                : root.advanced-section == "beast-settings" ? "the Beast settings"
                                : root.advanced-section == "rotation-dash" ? "the Rotation dashboard"
                                : root.advanced-section == "rotation-settings" ? "the Rotation settings"
                                : root.advanced-section == "warden-dash" ? "the Warden dashboard"
                                : root.advanced-section == "warden-settings" ? "the Warden settings"
                                : root.advanced-section == "inu-dash" ? "the Wire Cake Inu dashboard"
                                : root.advanced-section == "inu-settings" ? "the Wire Cake Inu settings"
                                : root.advanced-section == "underground-dash" ? "the Underground Layer court"
                                : root.advanced-section == "underground-settings" ? "the Underground Layer law"
                                : root.advanced-section == "carbon-dash" ? "the Carbon Browser — the 13th pillar"
                                : root.advanced-section == "carbon-settings" ? "the Carbon settings"
                                : "the pillar private tabs";
                            color: ThemeBook.burger.muted;
                            font-size: 10px;
                        }
                    }
                    Rectangle { }
                    Rectangle {
                        width: 44px;
                        border-radius: 8px;
                        background: shell-close-ta.pressed ? ThemeBook.burger.panel : transparent;
                        animate background { duration: 160ms; }
                        // #GLOSS: the TRUE ✕ — stroke-DRAWN, two crossed strokes: it can never read
                        // as a checkmark, and it is bright (hot accent on press), never grey.
                        Path {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 14px;
                            height: 14px;
                            viewbox-width: 14;
                            viewbox-height: 14;
                            commands: "M 1 1 L 13 13 M 13 1 L 1 13";
                            stroke: shell-close-ta.pressed ? ThemeBook.burger.accent : ThemeBook.burger.bright;
                            stroke-width: 2.5px;
                        }
                        shell-close-ta := TouchArea {
                            clicked => {
                                root.advanced-open = false;
                                root.close-advanced();
                            }
                        }
                    }
                }
            }

            // ---- The overlay body: the rail + the routed content ----
            HorizontalLayout {
                // THE RAIL (animated collapse — the burger drawer, in-shell). #33: navigating
                // flips the Demon-Slayer duality — ⚙ GENERAL walks the Infinity Castle (Akuma
                // chrome, the task-36 lean); ◆ PILLARS / ★ DNSCRYPT return to the Hashira side.
                Rectangle {
                    width: root.advanced-drawer-open ? 148px : 0px;
                    clip: true;
                    background: ThemeBook.burger.floor;
                    animate width { duration: 160ms; easing: ease-out; }
                    // ---- #33 THE RAIL'S OWN CHROMA — the aurora treatment (pure animation-tick
                    //      sines; zero timers; luminosity rays drifting over the rail floor). ----
                    Rectangle {
                        property <float> ph: 0.5 + 0.5 * Math.sin(360deg * (animation-tick() / 6.4s));
                        property <color> ca: #3fd4c2;
                        property <color> cb: #ffb454;
                        property <color> cc: #a78bfa;
                        property <color> cd: #5e8bff;
                        background: @linear-gradient(165deg,
                            self.ca.mix(self.cc, self.ph).with-alpha(0.10) 0%,
                            self.cb.mix(self.ca, self.ph).with-alpha(0.05) 45%,
                            self.cd.mix(self.cb, self.ph).with-alpha(0.10) 100%);
                    }
                    // the drifting luminosity ray — the specular streak, walking the rail
                    Rectangle {
                        property <float> drift: Math.sin(360deg * (animation-tick() / 7.5s));
                        y: parent.height * (0.5 + 0.42 * self.drift) - 30px;
                        height: 60px;
                        background: @linear-gradient(190deg, #ffffff.with-alpha(0.0) 0%, #ffffff.with-alpha(0.06) 50%, #ffffff.with-alpha(0.0) 100%);
                    }
                    // the rail's spectrum seam — the vertical AURORA line hugging the content edge
                    Rectangle {
                        property <float> ph: 0.5 + 0.5 * Math.sin(360deg * (animation-tick() / 5.2s));
                        property <color> ca: #3fd4c2;
                        property <color> cb: #ffb454;
                        property <color> cc: #a78bfa;
                        property <color> cd: #5e8bff;
                        x: parent.width - 2px;
                        width: 2px;
                        background: @linear-gradient(180deg,
                            self.ca.mix(self.cc, self.ph) 0%,
                            self.cb.mix(self.ca, self.ph) 33%,
                            self.cc.mix(self.cb, self.ph) 66%,
                            self.cd.mix(self.cc, self.ph) 100%);
                    }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        RailEntry {
                            label: "HOME";
                            glyph: "⌂";
                            selected: false;
                            // Routing home closes the ||| overlay outright — the K5 single-mount
                            // law again: home is a tab, never a second pane inside the burger.
                            tapped => {
                                root.advanced-open = false;
                                root.active-tab = "home";
                                ThemeBook.akuma = false;
                            }
                        }
                        RailEntry {
                            label: "PILLARS";
                            glyph: "◆";
                            selected: root.advanced-section == "pillars";
                            tapped => { root.advanced-section = "pillars"; ThemeBook.akuma = false; }
                        }
                        RailEntry {
                            label: "DNSCRYPT";
                            glyph: "★";
                            accent: Candle.candle;
                            selected: false;
                            // The K5 section lives on the ③ DNS tab — the ONE host-fed mount;
                            // routing there keeps the truth single (never a second unfed pane).
                            tapped => {
                                root.advanced-open = false;
                                root.active-tab = "dns";
                                ThemeBook.akuma = false;
                            }
                        }
                        // ── (BUGS2 #64) The retired bottom bar's two non-duplicated routes now
                        // live HERE — the ||| burger is the ONE navigation authority. ENGINE ROOM
                        // is the tab hosting the TORTA ENGINE + FORWARDER + UNDERGROUND cards;
                        // QUERY is the virtualized live query feed. Same K5 single-mount idiom as
                        // the DNSCRYPT chip above: route the tab, close the overlay. ──
                        RailEntry {
                            label: "ENGINE ROOM";
                            glyph: "▲";
                            selected: false;
                            tapped => {
                                root.advanced-open = false;
                                root.active-tab = "engine";
                                ThemeBook.akuma = false;
                            }
                        }
                        RailEntry {
                            label: "QUERY";
                            glyph: "≡";
                            selected: false;
                            tapped => {
                                root.advanced-open = false;
                                root.active-tab = "query";
                                ThemeBook.akuma = false;
                            }
                        }
                        RailEntry {
                            label: "GENERAL";
                            glyph: "⚙";
                            selected: root.advanced-section == "general";
                            tapped => { root.advanced-section = "general"; ThemeBook.akuma = true; }
                        }
                        // ── #60B CARBON BROWSER — his OWN bar, apart from the pillars (Socio law:
                        // "something this powerful can't stay with the other pillars"). Graphite
                        // slab + carbon-ring cyan glint; routes to the carbon-dash section (honest
                        // build-state pane until the 60C renderer assimilation lands). ──
                        Rectangle {
                            height: 44px;
                            border-radius: 9px;
                            background: @linear-gradient(135deg, #16181b 0%, #2a2f34 42%, #101214 100%);
                            border-width: 1px;
                            border-color: root.advanced-section == "carbon-dash"
                                ? #8be9fd
                                : #8be9fd.with-alpha(0.38);
                            VerticalLayout {
                                padding: 4px;
                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 5px;
                                    // the charcoal lump — drawn, not a font glyph (the old
                                    // "⌬" rendered as tofu-[X] on the device font)
                                    CharcoalLump { lump-size: 15px; }
                                    Text {
                                        text: "CARBON";
                                        color: #eaf6fb;
                                        font-size: 10px; font-weight: 900;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: "BROWSER";
                                    color: #8be9fd.with-alpha(0.75);
                                    font-size: 7px; font-weight: 800;
                                    horizontal-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => { root.advanced-section = "carbon-dash"; ThemeBook.akuma = false; }
                            }
                        }
                        // ── #60B-2 CARBON ⚙ — his settings chip, seated WITH the bar (apart from
                        // the pillar rows): the Install Extension lane + the capabilities law + the
                        // 60G default-browser role, honest skeleton until 60F/60G land. ──
                        Rectangle {
                            height: 26px;
                            border-radius: 7px;
                            background: root.advanced-section == "carbon-settings" ? #2a2f34 : #16181b;
                            border-width: 1px;
                            border-color: root.advanced-section == "carbon-settings"
                                ? #8be9fd
                                : #8be9fd.with-alpha(0.25);
                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: "⚙";
                                    color: #8be9fd;
                                    font-size: 9px; font-weight: 900;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "CARBON SETTINGS";
                                    color: #8be9fd.with-alpha(0.80);
                                    font-size: 7px; font-weight: 800;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                clicked => { root.advanced-section = "carbon-settings"; ThemeBook.akuma = false; }
                            }
                        }
                        // ── #59 D1c DONATE mirror — seated directly BELOW the Carbon bar (Socio
                        // seating law). D2 LANDED: this row lives ON carbon-dash, so pane re-entry
                        // is a no-op.
                        //
                        // COMMENT CORRECTED (#60C-b): this used to claim the tap opens "the user's
                        // default browser" via `TortaSlintBridge.openDonate`. That stopped being
                        // true when #60C re-routed donate IN-APP through the text-mode lane — the
                        // handler at lib.rs `on_carbon_donate_direct` has not called openDonate
                        // since. A comment describing behaviour the code no longer has is worse
                        // than none: it is the shape of overclaim that survives review because it
                        // reads plausibly. The tap routes IN-APP; the ⧉ button beside it is the
                        // explicit, user-initiated way out to the system browser. ──
                        Rectangle {
                            height: 26px;
                            border-radius: 13px;
                            background: @linear-gradient(90deg,
                                #ff5a7a.with-alpha(0.16) 0%, #1a1416 55%, #ff5a7a.with-alpha(0.08) 100%);
                            border-width: 1px;
                            border-color: #ff5a7a.with-alpha(0.50);
                            HorizontalLayout {
                                alignment: center;
                                spacing: 5px;
                                Text {
                                    text: "♥";
                                    color: #ff5a7a;
                                    font-size: 11px; font-weight: 900;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "DONATE";
                                    color: #ffdfe6;
                                    font-size: 9px; font-weight: 800;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea { clicked => { root.carbon-donate-direct(); } }
                        }
                        // ⧉ — the explicit way out to the system browser. Separate control, so
                        // leaving the app is always the USER's act and never the app's.
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            background: #1a1416;
                            border-width: 1px;
                            border-color: #ff5a7a.with-alpha(0.35);
                            Text {
                                text: "⧉";
                                color: #ffdfe6;
                                font-size: 11px; font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.carbon-donate-external(); } }
                        }
                        Rectangle { }
                    }
                }

                // THE CONTENT REGION — visibility-switched overlays (the D2 alias law: gen's
                // forwarding aliases forbid an `if`; overlays keep pane state stable).
                Rectangle {
                    horizontal-stretch: 1;
                    background: ThemeBook.burger.ground;

                    ScrollView {
                        width: 100%;
                        height: 100%;
                        visible: root.advanced-section == "pillars";
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            Text {
                                text: "PER-PILLAR PRIVATE TABS";
                                color: Monokuma.dim;
                                font-size: 11px;
                                font-weight: 800;
                            }
                            for t in root.pillar-chips : PillarTab {
                                tab: t;
                                // 2-FEED-MaskSolver: the MASKSOLVER chip opens its in-shell dashboard
                                // pane (the "ms-dash" section); other pillars stay host-routed until
                                // their panes embed (the next wave). The host still gets the id to
                                // (re)feed the pane from the live MaskSolver Object.
                                open-dashboard(id) => {
                                    root.advanced-section = id == "masksolver" ? "ms-dash"
                                        : id == "centauri" ? "centauri-dash"
                                        : id == "beast" ? "beast-dash"
                                        : id == "rotation" ? "rotation-dash"
                                        : id == "warden" ? "warden-dash"
                                        : id == "inu" ? "inu-dash"
                                        : id == "underground" ? "underground-dash"
                                        // ★ #49 — the FORWARDER is the engine plane's datapath, not
                                        // a ninth pillar; it rides the same rail because the rail is
                                        // where dashboards live.
                                        : id == "forwarder" ? "forwarder-dash"
                                        : root.advanced-section;
                                    // The DNSCrypt pillar (the 7th, the namesake) routes to the ③ DNS
                                    // tab — the ONE host-fed K5 DnscryptSection mount (its live
                                    // dashboard AND its advanced settings ARE that single typed surface;
                                    // the EXACT route the rail's DNSCRYPT entry takes, never a 2nd unfed
                                    // pane — the felt-truth single-authority law).
                                    if (id == "dnscrypt") {
                                        root.active-tab = "dns";
                                        root.advanced-open = false;
                                    }
                                    root.open-pillar-dashboard(id);
                                }
                                open-settings(id) => {
                                    if (id == "dnscrypt") {
                                        root.active-tab = "dns";
                                        root.advanced-open = false;
                                    }
                                    // 2-FEED-Centauri (SETTINGS): the CENTAURI SETTINGS chip now opens its
                                    // in-shell pane (the "centauri-settings" section) instead of the silent
                                    // host no-op — the first per-pillar SETTINGS surface made reachable +
                                    // fed + WRITE-wired on-device. Other pillars stay host-routed until
                                    // their settings panes embed (the #23 cross-pillar wave).
                                    if (id == "centauri") {
                                        root.advanced-section = "centauri-settings";
                                    }
                                    // 2-FEED-Warden (SETTINGS): the WARDEN SETTINGS chip opens its in-shell pane
                                    // (the "warden-settings" section) — the second per-pillar SETTINGS surface made
                                    // reachable + fed + WRITE-wired on-device (the #23 cross-pillar wave, after Centauri).
                                    if (id == "warden") {
                                        root.advanced-section = "warden-settings";
                                    }
                                    // 2-FEED-MaskSolver (SETTINGS): the MASKSOLVER SETTINGS chip opens its in-shell
                                    // pane (the "ms-settings" section) — the third per-pillar SETTINGS surface made
                                    // reachable + fed + WRITE-wired on-device (the #23 cross-pillar wave; the resolver
                                    // is the DNSCrypt fulcrum, so its 15 retry/cache/guard knobs matter most).
                                    if (id == "masksolver") {
                                        root.advanced-section = "ms-settings";
                                    }
                                    // 2-FEED-Rotation (SETTINGS): the ROTATION SETTINGS chip opens its in-shell
                                    // pane (the "rotation-settings" section) — the fourth per-pillar SETTINGS
                                    // surface (the #23 wave). The wheel's cadence/pin/rotate-now controls ride
                                    // Kotlin destinations (the NO-FORK consensus), not resolver_set_*.
                                    if (id == "rotation") {
                                        root.advanced-section = "rotation-settings";
                                    }
                                    // 2-FEED-Beast (SETTINGS): the BEAST SETTINGS chip opens its in-shell pane
                                    // (the "beast-settings" section) — the fifth per-pillar SETTINGS surface
                                    // (the #23 wave). The YeAH brain / CAKE queue / preset table + 4 tunables are
                                    // STAGED (no live torta_core setter); reapply-profile rebuilds the Beast.
                                    if (id == "beast") {
                                        root.advanced-section = "beast-settings";
                                    }
                                    // 2-FEED-Inu (SETTINGS): the WIRE CAKE INU SETTINGS chip opens its in-shell
                                    // pane (the "inu-settings" section) — the sixth + final per-pillar SETTINGS
                                    // surface (the #23 wave closer). The pair/protect/keep controls ride Kotlin
                                    // destinations (the ElevationManager / GrantEngine grant flow), not torta_core.
                                    if (id == "inu") {
                                        root.advanced-section = "inu-settings";
                                    }
                                    // #15 UNDERGROUND H: the UNDERGROUND LAYER SETTINGS chip opens the
                                    // tunable-law pane (the "underground-settings" section) — the pillar's
                                    // OWN space (the standing directive: out of the ENGINE tab).
                                    if (id == "underground") {
                                        root.advanced-section = "underground-settings";
                                    }
                                    // THE NETSTACK FORWARDER row had NO route here at all. Every
                                    // other row on this rail resolves to a section or a tab; this
                                    // one fell through to `open-pillar-settings("forwarder")`, which
                                    // no host handler claims -- so the button drew, took the tap,
                                    // animated, and did nothing. Measured on the AVD.
                                    //
                                    // It gets the ENGINE tab rather than a new pane because the
                                    // forwarder is NOT a ninth pillar (lib.rs:4687) -- it is the
                                    // engine plane's datapath, and its only control, the arm switch,
                                    // already lives there. The row's own OFF status literally reads
                                    // "arm the netstack forwarder on the ENGINE tab", so this makes
                                    // the button do what the row was already telling the user to do.
                                    if (id == "forwarder") {
                                        root.active-tab = "engine";
                                        root.advanced-open = false;
                                    }
                                    root.open-pillar-settings(id);
                                }
                            }
                            Rectangle { }
                        }
                    }

                    ScrollView {
                        width: 100%;
                        height: 100%;
                        visible: root.advanced-section == "general";
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            gen := GeneralSection { }
                        }
                    }

                    // ── #60B CARBON BROWSER — the carbon-dash section pane. FELT-TRUTH LAW: until
                    // the 60C renderer assimilation lands, this pane shows the REAL build state +
                    // the routing law — truth about the codebase, never fabricated telemetry. The
                    // analytics dashboard (traffic spared, RAM⊗NAND de-dup, QoS wins) arrives WITH
                    // the live renderer, host-fed — never sample defaults. ──
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        visible: root.advanced-section == "carbon-dash";
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 6px;
                                // drawn charcoal lump — no font glyph, no tofu-[X]
                                CharcoalLump { lump-size: 18px; }
                                Text {
                                    text: "CARBON BROWSER";
                                    color: #eaf6fb;
                                    font-size: 12px; font-weight: 900;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: "the sandboxed browser — every socket rides YeAH Tortä";
                                color: Monokuma.dim;
                                font-size: 9px;
                            }
                            // ── THE ENGINE TRUTH CARD — the honest answer to "is that circle
                            // loading?": NO. The 60C carbonyl engine is not assimilated yet, the
                            // browser cannot open, and NOTHING on this pane loads. ──
                            Rectangle {
                                border-radius: 7px;
                                background: #16181b;
                                border-width: 1px;
                                border-color: #ffb86c.with-alpha(0.45);
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 3px;
                                    Text {
                                        text: "ENGINE: TEXT-MODE v0 LIVE — real fetches, carbonyl look";
                                        color: #ffb86c;
                                        font-size: 9px; font-weight: 900;
                                    }
                                    Text {
                                        text: "the 60C text-mode lane is wired: the bar below fires a REAL fetch through the YeAH Tortä tunnel and renders the parsed page as terminal text. the full carbonyl pixel renderer stays the 60C roadmap — this pane never fakes it.";
                                        color: ThemeBook.burger.muted;
                                        font-size: 8px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            // ── #60C TEXT-MODE BROWSER v0 — the REAL browse bar. GO (or the
                            // keyboard accept) fires carbon-navigate() → host fetch → engine
                            // parse → the terminal page below. ──
                            HorizontalLayout {
                                spacing: 5px;
                                urlbox := LineEdit {
                                    text: root.carbon-url;
                                    placeholder-text: "https://…";
                                    font-size: 9px;
                                    accepted(t) => {
                                        root.carbon-url = t;
                                        root.carbon-navigate(t);
                                    }
                                }
                                Rectangle {
                                    width: 34px;
                                    border-radius: 5px;
                                    background: #8be9fd.with-alpha(0.16);
                                    border-width: 1px;
                                    border-color: #8be9fd.with-alpha(0.5);
                                    Text {
                                        text: "GO";
                                        color: #8be9fd;
                                        font-size: 9px; font-weight: 900;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.carbon-url = urlbox.text;
                                            root.carbon-navigate(urlbox.text);
                                        }
                                    }
                                }
                            }
                            if root.carbon-page-status != "" : Text {
                                text: root.carbon-page-status;
                                color: #8be9fd;
                                font-size: 8px;
                                wrap: word-wrap;
                            }
                            if root.carbon-page-lines.length > 0 : Rectangle {
                                height: 210px;
                                background: #0a0c0f;
                                border-width: 1px;
                                border-color: #8be9fd.with-alpha(0.25);
                                border-radius: 6px;
                                ScrollView {
                                    VerticalLayout {
                                        padding: 7px;
                                        spacing: 2px;
                                        for line in root.carbon-page-lines : Text {
                                            text: line;
                                            color: #b8f5c0;
                                            font-size: 9px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                            Text {
                                text: root.carbon-frame-live
                                    ? "pixel-path probe LIVE — the bridge painted this frame through the assimilated gfx primitives (60C-4). a test pattern: NOT the browser, NOT a loader."
                                    : "pixel-path probe — carbonyl assimilation lane (60C): pending";
                                color: root.carbon-frame-live ? #8be9fd : ThemeBook.burger.muted;
                                font-size: 9px;
                                wrap: word-wrap;
                            }
                            // ── #60C-4 THE SEAM SURFACE — visible ONLY once the host has fed a real
                            // frame (felt-truth law: no placeholder art). Graphite bezel + the
                            // CHARCOAL LUMP probe frame rendered in carbon_bridge::surface — the
                            // ember BREATHES on tick (the old orbiting glint read as a loader). ──
                            if root.carbon-frame-live : Rectangle {
                                height: 132px;
                                background: #0d0f13;
                                border-width: 1px;
                                border-color: #8be9fd.with-alpha(0.35);
                                border-radius: 6px;
                                Image {
                                    source: root.carbon-frame;
                                    width: parent.width - 8px;
                                    height: parent.height - 8px;
                                    image-fit: contain;
                                    image-rendering: pixelated;
                                }
                            }
                            if root.carbon-frame-live : Text {
                                text: "the ember breathes to prove the pixel path stays live — it never spins. a loader spins; an ember breathes.";
                                color: ThemeBook.burger.muted;
                                font-size: 8px;
                                wrap: word-wrap;
                            }
                            // ── #60B-3 LIVE ANALYTICS — the chips arrive WITH the renderer
                            // (felt-truth: same gate as the seam surface). Every number is read
                            // off the live CarbonSurface each tick — frames finished, pixels the
                            // last frame genuinely wrote, the real RGBA8 payload per frame. ──
                            if root.carbon-frame-live : HorizontalLayout {
                                spacing: 6px;
                                Rectangle {
                                    background: #0d0f13;
                                    border-width: 1px;
                                    border-color: #8be9fd.with-alpha(0.25);
                                    border-radius: 5px;
                                    VerticalLayout {
                                        padding: 5px;
                                        Text {
                                            text: root.carbon-frames;
                                            color: #8be9fd;
                                            font-size: 11px; font-weight: 900;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: "frames rendered";
                                            color: ThemeBook.burger.muted;
                                            font-size: 8px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                                Rectangle {
                                    background: #0d0f13;
                                    border-width: 1px;
                                    border-color: #8be9fd.with-alpha(0.25);
                                    border-radius: 5px;
                                    VerticalLayout {
                                        padding: 5px;
                                        Text {
                                            text: root.carbon-px;
                                            color: #8be9fd;
                                            font-size: 11px; font-weight: 900;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: "px written / frame";
                                            color: ThemeBook.burger.muted;
                                            font-size: 8px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                                Rectangle {
                                    background: #0d0f13;
                                    border-width: 1px;
                                    border-color: #8be9fd.with-alpha(0.25);
                                    border-radius: 5px;
                                    VerticalLayout {
                                        padding: 5px;
                                        Text {
                                            text: root.carbon-kib + " KiB";
                                            color: #8be9fd;
                                            font-size: 11px; font-weight: 900;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: "payload / frame";
                                            color: ThemeBook.burger.muted;
                                            font-size: 8px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                            Text {
                                // #60D — pending line until the host has genuinely probed the seam
                                text: root.carbon-route == ""
                                    ? "routing law — Beast QoS + Centauri + Underground, wired at the socket layer (60D)"
                                    : root.carbon-route;
                                color: root.carbon-route == "" ? ThemeBook.burger.muted : #8be9fd;
                                font-size: 9px;
                                wrap: word-wrap;
                            }
                            Text {
                                // #60E — pending line until the host has genuinely armed the jail
                                text: root.carbon-sandbox == ""
                                    ? "sandbox hardening — process isolation, fs jail, per-site permission map (60E)"
                                    : root.carbon-sandbox;
                                color: root.carbon-sandbox == "" ? ThemeBook.burger.muted : #50fa7b;
                                font-size: 9px;
                                wrap: word-wrap;
                            }
                            // (the 60E/60F/60G commentary rows lived here — user report:
                            // "too many code notes". The capabilities story lives in CARBON
                            // SETTINGS now; the dash keeps only live truth.)
                            Text {
                                text: "base: carbonyl v0.0.3 (BSD-3, © 2023 Fathy Boundjadj — notice retained) · integration © Saimonokuma";
                                color: #8be9fd.with-alpha(0.55);
                                font-size: 8px;
                            }
                        }
                    }

                    // ── #60B-2 CARBON SETTINGS — the carbon-settings section pane (carbon_settings.slint
                    // CarbonSettingsPane): Install Extension lane + the capabilities law + the 60G role —
                    // honest skeleton; the host wires the typed callbacks when 60F/60G land. ──
                    CarbonSettingsPane {
                        width: 100%;
                        height: 100%;
                        visible: root.advanced-section == "carbon-settings";
                        extension-engine-landed: root.carbon-extension-engine-landed;
                        specials-status: root.carbon-specials-status;
                        install-extension-tapped => { root.carbon-install-extension-tapped(); }
                    }

                    // 2-FEED-MaskSolver: the MaskSolver pillar DASHBOARD mounted IN-SHELL (the ms-dash
                    // section) — reached via the ||| → PILLARS → MASKSOLVER dashboard chip. The host
                    // feeds `msp` field-for-field from the live MaskSolver Object on each open; the
                    // PILLARS rail entry (or ✕) returns. This is the "next wave" the D3 note promised,
                    // done for MaskSolver: a pillar dashboard reachable + fed on-device.
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        visible: root.advanced-section == "ms-dash";
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            msp := MaskSolverPane { }
                        }
                    }

                    // 2-FEED-MaskSolver (SETTINGS): the MaskSolver pillar SETTINGS mounted IN-SHELL (the
                    // ms-settings section) — reached via ||| → PILLARS → MASKSOLVER settings chip. Unlike the
                    // read-only dashboard, this pane WRITES the live resolver: the instant toggles each fire a
                    // typed `masksolver-*` callback the host drives to a REAL resolver_set_* setter (one-way to
                    // the single armed process-globals); the config-carried knobs STAGE onto the `mss-*` aliases
                    // and land together on reapply-config. The host feeds the current resolver posture onto the
                    // `mss-*` aliases at startup + each second while shown; close-settings (or the PILLARS rail)
                    // returns. MaskSolverSettingsPane inherits Rectangle so it embeds on the single android
                    // surface (the CentauriSettingsPane / WardenSettingsPane precedent).
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        visible: root.advanced-section == "ms-settings";
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            msset := MaskSolverSettingsPane {
                                solve-ladder-toggled(on) => { root.masksolver-solve-ladder-toggled(on); }
                                all-servers-toggled(on) => { root.masksolver-all-servers-toggled(on); }
                                rebind-protect-toggled(on) => { root.masksolver-rebind-protect-toggled(on); }
                                bogus-priv-toggled(on) => { root.masksolver-bogus-priv-toggled(on); }
                                proxy-dnssec-toggled(on) => { root.masksolver-proxy-dnssec-toggled(on); }
                                never-forward-toggled(on) => { root.masksolver-never-forward-toggled(on); }
                                cache-rr-toggled(on) => { root.masksolver-cache-rr-toggled(on); }
                                serve-stale-toggled(on) => { root.masksolver-serve-stale-toggled(on); }
                                cache-cap-stepped(v) => { root.masksolver-cache-cap-stepped(v); }
                                timeout-stepped(v) => { root.masksolver-timeout-stepped(v); }
                                serve-stale-secs-stepped(v) => { root.masksolver-serve-stale-secs-stepped(v); }
                                ttl-floor-stepped(v) => { root.masksolver-ttl-floor-stepped(v); }
                                ttl-ceiling-stepped(v) => { root.masksolver-ttl-ceiling-stepped(v); }
                                rotation-cadence-stepped(v) => { root.masksolver-rotation-cadence-stepped(v); }
                                // expert-toggled self-managed by the pane (it flips its own expert-open reveal).
                                reapply-config() => { root.masksolver-reapply-config(); }
                                close-settings() => { root.advanced-section = "pillars"; }
                            }
                        }
                    }

                    // 2-FEED-Centauri: the Centauri pillar DASHBOARD mounted IN-SHELL (the
