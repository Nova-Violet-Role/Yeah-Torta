    // ★ N-dial-UDP — forwarded for the same reason the four above are: a property that exists on the
    // engine tab but is not bridged to TortaShell cannot be set by the Rust feed, so the tile renders a
    // permanent 0 while the engine counts correctly. A silent-zero tile is worse than no tile, because
    // it reads as "no UDP dial ever failed" — which is exactly the false reassurance being fixed here.
    in-out property <int> fwd-udp-dial-protect-failed <=> eng.fwd-udp-dial-protect-failed;
    in-out property <int> fwd-udp-dial-connect-failed <=> eng.fwd-udp-dial-connect-failed;
