    in-out property <[QueryRow]> dc-live-queries <=> dc.live-queries;
    in-out property <int> dc-live-query-count <=> dc.live-query-count;
    // ★ #97 — the PQ witness rides the SAME mount and the SAME 500 ms poll as `dc-live-state`. Named
    //   with the `dc-` prefix the host feeds by (the #66 law: a property is fed under the name its
    //   PARENT gives it, not the name it declares).
    in-out property <int> dc-pq-exchanges <=> dc.pq-exchanges;
    in-out property <int> dc-pq-classic <=> dc.pq-classic;

