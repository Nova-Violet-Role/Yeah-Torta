// The Tortä SLINT root module — the rust-native UI substrate, COMPLETE (OMEGA Stage-D · D3).
//
// This is the COMPILED root (build.rs compiles ONLY this file; every surface enters the graph via a
// re-export or import from here). The substrate arc closed in three steps: D1 (#69) opened the
// on-device render rail, D2 raised the ||| Advanced burger (step 7 — the navigation surface), and
// D3 raised THE DESIGN FINALE (step 8 — home_shell.slint `TortaShell`, the 4-tab Home: ① HOME the
// dnsmasq×rethink hybrid · ② Tortä ENGINE · ③ DNS the K5 section · ④ QUERY the unified log feed),
// which RETIRED the `TortaRoot` proof-of-substrate stub that used to close this file — the last
// Garmatin-shaped surface concept (the InviZible main screen) is now a Rust-native original.
//
// SLINT markup = rust-flavored declarative UI (like a typed QML). Components → Rust structs; callbacks →
// Rust fns; properties → typed Rust fields. NOTE: slint uses `:` (colon) for property bindings, not `=`.

// The Warden dashboard (slice 8) lives in its own .slint. Re-exporting it from the COMPILED root file
// (build.rs compiles main.slint) is what surfaces `WardenDashboard` + `AppRow` as generated Rust structs
// through `slint::include_modules!()` — the host (lib.rs proof test / Kotlin bridge) constructs it + pushes
// a live `WardenSnapshot`. Both inherit Window, so the dashboard is a sibling preview surface, not embedded.
export { WardenDashboard, AppRow } from "warden.slint";

// The Warden |||  SETTINGS section (slice 9) lives in its own .slint, re-exported from the COMPILED root the
// same way — this surfaces `WardenSettings` + its row structs (`UniversalToggle` / `RuleEntry` / `AppToggleRow`)
// as generated Rust structs through `slint::include_modules!()`. The host constructs it, pushes the live armed
// Warden state (toggles / rules / matrix), and wires the edit callbacks to the `WardenObject` setters. (No trust
// row: the Warden layer has no trust concept by design law.) It REPLACES every legacy firewall settings screen.
export { WardenSettings, UniversalToggle, RuleEntry, AppToggleRow } from "warden_settings.slint";

// The Centauri offline-CDN CONSTELLATION dashboard (slice 8) — re-exported from the COMPILED root the same way
// so `CentauriDashboard` + its `ServeRow` feed struct surface as generated Rust structs through
// `slint::include_modules!()`. The host constructs it, pulls a live `CentauriSnapshot` (mirror::object,
// object.rs:346) + the cloaked-host watch-list (centauri_cdn_hosts(), lib.rs:1568), and pushes the CROWN
// witness counters — so "the CDN saw ≤ 1 / saw 0" renders from REAL counters (Chroma F2), never asserted.
export { CentauriDashboard, ServeRow } from "centauri.slint";

// The Centauri |||  SETTINGS section (slice 9) — re-exported the same way: `CentauriSettings` + its `CdnHostRow`
// surface as generated Rust structs. The host pushes the live opt-out state (strict / cloak / seed policy +
// the catalog-assets/libraries scalars) and wires the edit callbacks to `Centauri::set_cache_mode` /
// `resolver_set_centauri_cloak` / `Centauri::warm_up`. It REPLACES the legacy CentauriPillarFragment + its XML.
export { CentauriSettings, CdnHostRow } from "centauri_settings.slint";

// The MaskSolver (Resolver&Cache pillar) dashboard (slice 8) — re-exported from the COMPILED root the same way
// so `MaskSolverDashboard` + its `MaskRow` (the query-masksolver.log resolve feed) + `MaskTransportRow` (the R7
// per-upstream RTT/loss EWMA health row) surface as generated Rust structs through `slint::include_modules!()`.
// The host constructs it, pulls a live `MaskSolver::snapshot()`/`solve_state()` (resolver::object, object.rs:427/490)
// via the UniFFI Object + tails `query-masksolver.log`, and pushes each field — so the SOLVE/CACHE witnesses +
// the 🩸 hidden-fault hunt (DEAD POOL / SILENT MISS / REBIND LEAK / STALE-SERVING / LADDER STORM / PANIC) render
// from REAL atomics (the single-source proof, no engine fork — Chroma F1/F2), never asserted. Its palette global
// `Masque` (masksolver_palette.slint, slice 10) is pulled into the compile graph by the dashboard's own import.
// 2-FEED-MaskSolver: the shell mounts the Rectangle-rooted `MaskSolverPane` IN-SHELL (||| → PILLARS →
// MASKSOLVER dashboard chip), imported directly from masksolver.slint; the host feeds it field-for-
// field from the live `MaskSolver` Object. `MaskSolverDashboard` stays the FORWARDING Window wrapper
// (preview + the lib.rs proof test) — a non-Window pane re-exported here would generate no code.
export { MaskSolverDashboard, MaskRow, MaskTransportRow } from "masksolver.slint";

// The MaskSolver |||  SETTINGS section (slice 9) — re-exported from the COMPILED root the same way so
// `MaskSolverSettings` surfaces as a generated Rust struct through `slint::include_modules!()`. The host pushes
// the live posture (pool state · the SOLVE retry/failover toggles · the cache size/serve-stale/TTL config · the
// P12 rebind guard · the rotation cadence) and wires the edit callbacks to the `MaskSolver` Expert setters
// (`set_solve_ladder` / `set_all_servers` / `set_rebind_enforce` / …) + the config-carried `configure()`
// re-apply — so the 🎷 decision-point guard (DEAD-POOL ARM / REBIND-OFF / SHORT-DEADLINE / STALE-INERT /
// TINY-CACHE) warns where a counterproductive choice is MADE, from REAL host-pushed state (Chroma F2), not asserted.
export { MaskSolverSettings } from "masksolver_settings.slint";

// The Beast (the flagship CAKE × YeAH flow engine) dashboard — the surface overhaul of the landed Genesis
// engine. Re-exported from the COMPILED root the same way so `BeastDashboard` + its `BeastTickRow` (the
// query-beast.log recent-tick feed struct) surface as generated Rust structs through `slint::include_modules!()`.
// The host constructs it, pulls a live `BeastSnapshot` (beast::mod, mod.rs:128) via the UniFFI Object two ways
// (the `BeastMetricSink` push callback OR the `Beast::snapshot()` poll-free pull, both from the ONE
// `build_snapshot` reader so they can't drift), and pushes each field — so THE CAKE-FOUNTAIN (per-tin fill +
// the advanced-depth per-tin CoBALT valves / DRR++ fairness / live YeahMode) renders from REAL engine reads
// (Chroma F16), with the canonical + CoBALT cards profile-gated so a Legacy brain's inert 0s never read as live
// (Chroma F6). Its palette global `Beast` (beast_palette.slint, slice 10) is pulled into the compile graph by
// the dashboard's own import. 2-FEED-Beast adds `BeastPane` — the Rectangle-rooted embeddable pane the shell
// mounts in-shell (||| → PILLARS → BEAST dashboard chip), host-fed a live `BeastSnapshot` field-for-field.
// `BeastPane` is NOT re-exported here — a non-Window pane exported from the root generates NO Rust code (the
// measured slint rule); it enters the compile graph via home_shell.slint's direct import + the FORWARDING
// `BeastDashboard` Window wrapper (preview + the lib.rs proof test). The on-device render is live via #69.
export { BeastDashboard, BeastTickRow } from "beast.slint";

// ★ #49 · THE NETSTACK FORWARDER dashboard (the per-flow docket surface #47/#48 built the engine and
// the seam for). Re-exported from the COMPILED root so `ForwarderDashboard` + its `FwdFlowRow` (one
// live flow) surface as generated Rust structs through `slint::include_modules!()`. `ForwarderPane`
// — the Rectangle-rooted embeddable the shell actually renders — is deliberately NOT re-exported
// here: the measured slint rule above (a non-Window pane exported from the root generates NO Rust
// code) applies to it exactly as it does to BeastPane. It enters the compile graph through
// home_shell.slint's direct import plus this forwarding Window wrapper (preview + proof test).
export { ForwarderDashboard, FwdFlowRow } from "forwarder_dashboard.slint";

// The Beast |||  SETTINGS section (slice 9) — re-exported from the COMPILED root the same way so `BeastSettings`
// surfaces as a generated Rust struct through `slint::include_modules!()`. The host pushes the live applied tune
// (the YeahProfile brain / CakeProfile queue from BeastSnapshot + the beast_preset-resolved tunables) and wires
// the edit callbacks to the profile REBUILD (`Beast::new`, mod.rs:165 — profile is construction-time, so a change
// reconstructs the Object) + the flat `beast_preset`/`beast_clamp` tune table (lib.rs:376/417). The 🎷 Violet
// decision-point guard warns/informs where the choice is MADE — the Chroma F6 profile-blindness honesty (Legacy
// picks make the deep dashboard cards go dark) surfaced BEFORE the user puzzles over a graph of zeros.
export { BeastSettings } from "beast_settings.slint";

