    // UNDERGROUND — Matrix rain: phosphor green on terminal black.
    // (No palette file yet — task #29 extracts these into underground_palette.)
    out property <SectionTheme> underground: {
        name: "THE MATRIX", motif: "01",
        ground: #050a06, floor: #0a140c, panel: #0e1a10,
        edge: #1c3a22, track: #1c3a22,
        bright: #d8ffe0, muted: #6fae7f, faint: #4a7a56,
        accent: #2fe26a, accent2: #9dffb0,
        good: #2fe26a, warn: #f0a830, bad: #ef4d57,
        wound: #a5342a, strike: #ffffff,
        title-size: 15px, title-weight: 800,
        value-size: 20px, value-weight: 700,
        label-size: 10px, label-weight: 700,
    };

    // ================= THE APP SURFACES (seeded here, graduate later) ==========

    // HOME — the dessert tower: parfait gold + strawberry cream (task #34's canvas).
    out property <SectionTheme> home: {
        name: "THE DESSERT TOWER", motif: "TORTÄ",
        ground: Candle.wax, floor: Candle.wick.with-alpha(0.68), panel: Candle.panel.with-alpha(0.58),
        edge: Candle.hairline, track: Candle.track.with-alpha(0.45),
        bright: Candle.bright, muted: Candle.haze, faint: Candle.dim,
        accent: Candle.candle, accent2: #f2a6c2,
        good: Candle.safe, warn: Candle.caution, bad: Candle.breach,
        wound: Candle.wound, strike: Candle.strike,
        title-size: 18px, title-weight: 900,
        value-size: 23px, value-weight: 900,
        label-size: 10px, label-weight: 700,
    };

    // GENERAL — the gear room: neutral steel (task #36 raises the Infinity Castle).
    out property <SectionTheme> general: {
        name: "THE GEAR ROOM", motif: "⚙",
        ground: #101218, floor: #161a22, panel: #1a1f2a,
        edge: #2a3242, track: #2a3242,
        bright: #e8edf6, muted: #93a0b5, faint: #5f6b80,
        accent: #7f9db8, accent2: #b8c4d6,
        good: #2ecc71, warn: #f39c12, bad: #ef4d57,
        wound: #c0392b, strike: #ffffff,
        title-size: 16px, title-weight: 800,
        value-size: 21px, value-weight: 700,
        label-size: 10px, label-weight: 700,
