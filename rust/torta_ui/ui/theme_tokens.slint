    out property <SectionTheme> oni: {
        name: "UPPER MOONS", motif: "月",
        ground: #0d0812, floor: #150d1c, panel: #1a1024,
        edge: #33204a, track: #33204a,
        bright: #f6eefc, muted: #a08cb8, faint: #6c5a84,
        accent: #c026d3, accent2: #7c3aed,
        good: #2ecc71, warn: #f39c12, bad: #ff2447,
        wound: #8b1a3a, strike: #ffffff,
