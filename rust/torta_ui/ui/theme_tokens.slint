        ground: Centauri.void, floor: Centauri.nebula.with-alpha(0.68), panel: Centauri.panel.with-alpha(0.58),
        edge: Centauri.hairline, track: Centauri.track.with-alpha(0.45),
        bright: Centauri.starlight, muted: Centauri.haze, faint: Centauri.dim,
        accent: Centauri.stellar, accent2: Centauri.crown,
        good: Centauri.crown, warn: Centauri.caution, bad: Centauri.breach,
