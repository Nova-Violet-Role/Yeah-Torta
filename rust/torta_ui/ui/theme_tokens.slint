    // THE RUNTIME SWITCH — consumers bind `burger`; flipping `akuma` restyles
    // every bound consumer in one assignment (the load-bearing proof).
    in-out property <bool> akuma: false;
    out property <SectionTheme> burger: root.akuma ? root.oni : root.hashira;
}

// ── THE MOTIF WASH (#24 wave-2) — the ONE drifting-calligraphy identity layer. Every pillar
//    header mounts THIS component instead of hand-rolling glyphs (dnscrypt_section precedent):
//    name-calligraphy + motif glyph + accent token, all breathing on animation-tick().
//    Pure decor — clipped strip, no hit surface, feeds ONLY from the pillar's SectionTheme. ──
// THE SECTION DRENCH — a FULL-SURFACE theme wash (not a top band). Mount it as the FIRST child
// of a pillar pane and it fills the whole scrollable surface: a faint duotone gradient soak +
// the section's motif glyphs drifting at %-scattered coords. Panels above it ride the ThemeBook
// glass tokens (panel/floor carry alpha) so the wash breathes through the ENTIRE Dashboard/Settings.
export component MotifWash inherits Rectangle {
    in property <SectionTheme> theme;
    in property <string> extra: "〜 ★ 〜";
    clip: true;
    // ---- the drench: a vertical duotone soak, accent up top, accent2 sinking to the floor ----
    Rectangle {
        background: @linear-gradient(168deg,
            root.theme.accent.with-alpha(0.10) 0%,
            root.theme.ground.with-alpha(0.00) 34%,
            root.theme.accent2.with-alpha(0.07) 72%,
            root.theme.accent.with-alpha(0.11) 100%);
    }
    // ---- the NAME banner, drifting across the top strip ----
    Text {
        text: root.theme.name;
        color: root.theme.accent2;
        opacity: 0.20 + 0.07 * Math.sin(360deg * (animation-tick() / 7s));
        font-size: 30px;
        font-weight: 900;
        font-italic: true;
        x: parent.width - 330px + 26px * Math.sin(360deg * (animation-tick() / 11s));
        y: parent.height * 2% + 7px * Math.sin(360deg * (animation-tick() / 5.5s));
        transform-rotation: -12deg + 4deg * Math.sin(360deg * (animation-tick() / 9s));
    }
    // ---- #22 the WHOLE-SCROLL drench: band repeaters that scale with content height.
    //      The old anchors were %-of-height — six sparks stretched over any scroll length,
    //      leaving the deep third matt. Bands are px-pitched; count = height/pitch, so a
    //      12000px pillar gets ~8 giants, ~22 glyphs, ~10 words. Every band is unique via
    //      golden-angle sin scatter (i * primes), parity-flipped left/right. ----
    property <int> giant-bands: Math.max(1, Math.floor(self.height / 1600px) + 1);
    property <int> glyph-bands: Math.max(2, Math.floor(self.height / 560px) + 1);
    property <int> word-bands:  Math.max(1, Math.floor(self.height / 1240px) + 1);
    // ---- the GIANT watermark: one enormous motif per ~1600px band ----
    for g in root.giant-bands : Text {
        text: root.theme.motif;
        color: Math.sin(g * 137deg) > 0 ? root.theme.accent : root.theme.accent2;
        opacity: 0.075 + 0.025 * Math.sin(360deg * (animation-tick() / 19s) + g * 67deg);
        font-size: 170px + 60px * Math.abs(Math.sin(g * 53deg));
        font-weight: 900;
        x: parent.width * (Math.sin(g * 137deg) > 0 ? 52% : 4%) + 18px * Math.sin(360deg * (animation-tick() / 23s) + g * 41deg);
        y: g * 1600px + 340px * Math.abs(Math.sin(g * 79deg)) + 14px * Math.sin(360deg * (animation-tick() / 17s) + g * 29deg);
        transform-rotation: -14deg + 9deg * Math.sin(g * 97deg) + 3deg * Math.sin(360deg * (animation-tick() / 29s) + g * 59deg);
    }
    // ---- the glyph rain: a motif every ~560px, scattered edge-to-edge ----
    for i in root.glyph-bands : Text {
        text: root.theme.motif;
        color: Math.sin(i * 137deg) > 0 ? root.theme.accent2 : root.theme.accent;
        opacity: 0.12 + 0.05 * Math.sin(360deg * (animation-tick() / 8s) + i * 47deg);
        font-size: 26px + 24px * Math.abs(Math.sin(i * 51deg));
        font-weight: 900;
        x: parent.width * (6% + 74% * Math.abs(Math.sin(i * 73deg))) + 14px * Math.sin(360deg * (animation-tick() / 13s) + i * 61deg);
        y: i * 560px + 60px + 120px * Math.abs(Math.sin(i * 83deg)) + 9px * Math.sin(360deg * (animation-tick() / 7.5s) + i * 83deg);
        transform-rotation: -12deg + 24deg * Math.sin(i * 107deg) + 4deg * Math.sin(360deg * (animation-tick() / 12s) + i * 31deg);
    }
    // ---- the word band: name/extra alternating down the scroll (~1240px pitch) ----
    for w in root.word-bands : Text {
        text: Math.sin(w * 137deg) > 0 ? root.theme.name : root.extra;
        color: Math.sin(w * 91deg) > 0 ? root.theme.accent : root.theme.good;
        opacity: 0.11 + 0.05 * Math.sin(360deg * (animation-tick() / 6s) + w * 53deg);
        font-size: 16px + 14px * Math.abs(Math.sin(w * 67deg));
        font-weight: 900; font-italic: true;
        x: parent.width * (10% + 60% * Math.abs(Math.sin(w * 113deg))) + 16px * Math.sin(360deg * (animation-tick() / 15s) + w * 71deg);
        y: w * 1240px + 420px + 160px * Math.abs(Math.sin(w * 43deg)) + 11px * Math.sin(360deg * (animation-tick() / 9.5s) + w * 37deg);
        transform-rotation: -7deg + 13deg * Math.sin(w * 61deg);
    }
}

// ── #36 THE UPPER MOON SEAL — the demon mirror of the Hashira law: every pillar DASH is a
// Hashira, so every pillar SETTINGS pane bears the matching Upper Moon's engraved rank.
// A static identity seal (felt-truth: pure identity, zero fabricated state) — kanji rank +
// latin name on SOLID lacquer. Each pane declares it LAST, so it rides above the drench
// (slint paints in declaration order; there is no z-index). ──
export component UpperMoonChip inherits Rectangle {
    in property <string> kanji;         // the engraved rank — e.g. "上弦・壱"
    in property <string> moon-name;     // the demon — e.g. "UPPER ONE — KOKUSHIBO"
    in property <color> tint: #b02a3a;
    width: seal.preferred-width + 22px;
    height: 26px;
    border-radius: 13px;
    background: #120a0c;                // SOLID lacquer — the no-transparency law
    border-width: 1px;
    border-color: root.tint;
    seal := HorizontalLayout {
        x: 11px;
        y: 0;
        height: 100%;
        spacing: 7px;
        Text {
            text: root.kanji;
            color: root.tint;
            font-size: 12px;
            font-weight: 900;
            vertical-alignment: center;
        }
        Text {
            text: root.moon-name;
            color: root.tint.with-alpha(0.85);  // foreground cover — alpha is legal here
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
    }
}

// ── CHARCOAL LUMP — the Carbon Browser identity glyph, DRAWN (the old "⌬"
// U+232C font glyph rendered as tofu-[X] on device fonts — same bug class as
// the wishlist tofu). Faceted coal + a live ember seam that BREATHES;
// brightness only, geometry fixed — an ember is not a loader. ──
export component CharcoalLump inherits Rectangle {
    in property <length> lump-size: 16px;
    in property <bool> ember: true;
    property <float> ph: 0.5 + 0.5 * Math.sin(360deg * (animation-tick() / 3.4s));
    width: self.lump-size; height: self.lump-size;
    background: transparent;
    // body facet
    Rectangle {
        x: root.lump-size * 0.08; y: root.lump-size * 0.30;
        width: root.lump-size * 0.84; height: root.lump-size * 0.52;
        border-radius: root.lump-size * 0.12;
        background: #17191c;
        border-width: 1px; border-color: #000000.with-alpha(0.55);
        transform-rotation: -6deg;
    }
    // top-left facet catching the light
    Rectangle {
        x: root.lump-size * 0.14; y: root.lump-size * 0.10;
        width: root.lump-size * 0.46; height: root.lump-size * 0.36;
        border-radius: root.lump-size * 0.10;
        background: #2a2f34;
        transform-rotation: 8deg;
    }
    // right shoulder facet
    Rectangle {
        x: root.lump-size * 0.52; y: root.lump-size * 0.20;
        width: root.lump-size * 0.38; height: root.lump-size * 0.32;
        border-radius: root.lump-size * 0.09;
        background: #212529;
        transform-rotation: -11deg;
    }
    // ember seam — breathes, never orbits
    Rectangle {
        x: root.lump-size * 0.28; y: root.lump-size * 0.58;
        width: root.lump-size * 0.42; height: root.lump-size * 0.11;
        border-radius: root.lump-size * 0.05;
        background: #ff6e40;
        opacity: root.ember ? 0.30 + 0.55 * root.ph : 0;
    }
    // ember mote
    Rectangle {
        x: root.lump-size * 0.62; y: root.lump-size * 0.46;
        width: root.lump-size * 0.10; height: root.lump-size * 0.10;
        border-radius: root.lump-size * 0.05;
        background: #ffa62b;
        opacity: root.ember ? 0.20 + 0.55 * root.ph : 0;
    }
    // carbon-cyan identity tick — static
    Rectangle {
        x: root.lump-size * 0.20; y: root.lump-size * 0.22;
        width: root.lump-size * 0.09; height: root.lump-size * 0.09;
        border-radius: root.lump-size * 0.04;
        background: #8be9fd.with-alpha(0.9);
    }
}
