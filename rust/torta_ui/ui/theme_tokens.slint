// ============================================================================
//  theme_tokens.slint — THE THEME-TOKEN SPINE  (#33, the 24-37 wave foundation)
//  ⬜ Soleil facet · SLINT/Rust token system — NO XML (the no-XML law).
// ============================================================================
//
// #23 (the master) calls for a NAME-DRIVEN identity per section: every pillar +
// HOME + GENERAL pulls its OWN palette · motif · typography from tokens, so a
// section's whole identity lives in ONE block, not scattered across a 54KB
// surface. This file is that spine:
//
//   • `SectionTheme` — the NORMALIZED slice-10 grammar every existing palette
//     already follows (panel scale → legibility scale → accents → verdicts →
//     track), plus the typography energy + the motif glyph, as ONE typed struct.
//   • `ThemeBook` — the global that binds each section's theme. Colors ALIAS
//     the existing per-pillar palette globals (Monokuma/Beast/Wheel/Masque/
//     Inu/Centauri-stellar/Candle) — the palette files STAY the single source
//     of color truth; the book normalizes the names. Sections without a palette
//     file yet (underground #29, home #34, general #36) seed their tokens HERE
//     and graduate to their own palette file in their own task.
//   • THE DEMON-SLAYER DUALITY — `hashira` (the heroes' chrome) vs `oni` (the
//     Upper-Moon chrome) as two full token sets, flipped at RUNTIME by the
//     `akuma` switch: the ||| burger chrome binds `ThemeBook.burger`, and
//     navigating to ⚙ GENERAL (the Infinity-Castle lean, task #36) flips the
//     whole chrome demon-side without touching a single consumer line. That
//     flip IS the load-bearing witness — the token is live state, not config.
//
// USAGE (a consumer surface):
//   import { ThemeBook } from "theme_tokens.slint";
//   background: ThemeBook.burger.ground;   color: ThemeBook.burger.bright;
//   // or a fixed section:  color: ThemeBook.warden.accent;
//
// GROUND RULES: additive-only this wave — pillar-pane INTERNALS keep reading
// their own palette globals (each restyle task 24-31 migrates its pillar onto
// its ThemeBook entry); the burger/shell CHROME is the first consumer.
// ============================================================================

import { Monokuma } from "monokuma_palette.slint";
import { Beast } from "beast_palette.slint";
import { Wheel } from "rotation_palette.slint";
import { Masque } from "masksolver_palette.slint";
import { Inu } from "inu_palette.slint";
import { Centauri } from "centauri_palette.slint";
import { Candle } from "dnscrypt_palette.slint";

// The normalized identity grammar — ONE struct, every section speaks it.
export struct SectionTheme {
    // ── identity ──
    name: string,          // the identity tag ("MONOKUMA COURT", "UPPER MOONS", …)
    motif: string,         // the recurring glyph/word token the surfaces reference
    // ── the panel scale (deepest → faintest) ──
    ground: color,         // the section window ground
    floor: color,          // row cards
    panel: color,          // lifted tiles
    edge: color,           // hairline borders on the dark
    track: color,          // toggle off-rail
    // ── the legibility scale ──
    bright: color,         // primary text
    muted: color,          // secondary text / labels
    faint: color,          // tertiary text / section titles
    // ── the brand accents ──
    accent: color,         // the section's signature color
    accent2: color,        // the lighter lick / secondary brand
    // ── the verdict grammar (shared across the app) ──
    good: color,
    warn: color,
    bad: color,
    wound: color,          // alert-banner FILL (≠ the accent stroke)
    strike: color,         // text struck on a filled banner
    // ── the typography energy ──
    title-size: length,    // section/crown titles
    title-weight: int,
    value-size: length,    // the big metric values
    value-weight: int,
    label-size: length,    // tile labels / chip text
    label-weight: int,
}

export global ThemeBook {
    // ================= THE EIGHT PILLARS (palette-file backed) =================

    // WARDEN — the Monokuma courtroom: black/white split, the red eye rules.
    out property <SectionTheme> warden: {
        name: "MONOKUMA COURT", motif: "X / O",
        ground: Monokuma.night, floor: Monokuma.pitch.with-alpha(0.68), panel: Monokuma.slate.with-alpha(0.58),
        edge: Monokuma.iron, track: Monokuma.iron.with-alpha(0.45),
        bright: Monokuma.bone, muted: Monokuma.ash, faint: Monokuma.dim,
        accent: Monokuma.risk, accent2: Monokuma.caution,
        good: Monokuma.safe, warn: Monokuma.caution, bad: Monokuma.risk,
        wound: Monokuma.wound, strike: Monokuma.strike,
        title-size: 17px, title-weight: 900,
        value-size: 22px, value-weight: 800,
        label-size: 10px, label-weight: 700,
    };

    // BEAST — the CAKE × YeAH oven: molten flow-orange on scorched black.
    out property <SectionTheme> beast: {
        name: "THE CAKE OVEN", motif: "CAKE ▲",
        ground: Beast.abyss, floor: Beast.pit.with-alpha(0.68), panel: Beast.panel.with-alpha(0.58),
        edge: Beast.hairline, track: Beast.track.with-alpha(0.45),
        bright: Beast.ink, muted: Beast.mist, faint: Beast.dim,
        accent: Beast.flow, accent2: Beast.cool,
        good: Beast.thrust, warn: Beast.caution, bad: Beast.shed,
