    // ================= THE DEMON-SLAYER DUALITY (the ||| burger chrome) ========
    //
    // ◆ PILLARS = the HASHIRA side (heroes: the Monokuma-neutral shell chrome the
    // D2 burger set, pillar-blue signature). ⚙ GENERAL = the AKUMA side (the
    // Upper-Moon chrome: demon crimson-violet on a deeper black — task #36's
    // Infinity Castle lean). `akuma` flips the WHOLE chrome set at runtime.

    out property <SectionTheme> hashira: {
        name: "HASHIRA", motif: "|||",
        // #36 GLASS WIRE — the PILLARS overlay panels go translucent (the DESCENT ambient
        // breathes through every card) and the hairlines turn ember wire (the castle's light).
        ground: Monokuma.night, floor: Monokuma.pitch.with-alpha(0.42), panel: Monokuma.slate.with-alpha(0.28),
        edge: #d98a3c.with-alpha(0.62), track: Monokuma.iron.with-alpha(0.45),
        bright: Monokuma.bone, muted: Monokuma.ash, faint: Monokuma.dim,
        accent: #5e8bff, accent2: #4ade80,
        good: Monokuma.safe, warn: Monokuma.caution, bad: Monokuma.risk,
